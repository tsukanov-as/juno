// Парсер: операторы.

Перем Проверка;

Процедура ТестПрисваивание() Экспорт
	Оператор = Проверка.Оператор("Х = 1;");
	Проверка.Равно(Оператор.Тип, "ОператорПрисваивания");
	Проверка.Равно(Оператор.ЛевыйОперанд.Голова.Имя, "Х");
	Проверка.Равно(Оператор.ПравыйОперанд.Значение, 1);
	// Присваивание полю объекта.
	Оператор = Проверка.Оператор("Объект.Поле = 1;");
	Проверка.Равно(Оператор.ЛевыйОперанд.Голова.Имя, "Объект");
	Проверка.Равно(Оператор.ЛевыйОперанд.Хвост[0].Имя, "Поле");
КонецПроцедуры

Процедура ТестВызовПроцедуры() Экспорт
	Оператор = Проверка.Оператор("Сообщить(""привет"");");
	Проверка.Равно(Оператор.Тип, "ОператорВызоваПроцедуры");
	Проверка.Равно(Оператор.Идентификатор.Голова.Имя, "Сообщить");
	Проверка.Равно(Оператор.Идентификатор.Аргументы.Количество(), 1);
КонецПроцедуры

Процедура ТестЕслиСоВсемиВетками() Экспорт
	Оператор = Проверка.Оператор("Если А Тогда Х = 1; ИначеЕсли Б Тогда ИначеЕсли В Тогда Иначе Х = 2; КонецЕсли;");
	Проверка.Равно(Оператор.Тип, "ОператорЕсли");
	Проверка.Равно(Оператор.Выражение.Голова.Имя, "А");
	Проверка.Равно(Оператор.Тогда.Количество(), 1);
	Проверка.Равно(Оператор.ИначеЕсли.Количество(), 2);
	Проверка.Равно(Оператор.ИначеЕсли[1].Выражение.Голова.Имя, "В");
	Проверка.Равно(Оператор.Иначе.Тип, "ОператорИначе");
	Проверка.Равно(Оператор.Иначе.Операторы.Количество(), 1);
КонецПроцедуры

Процедура ТестЕслиБезВеток() Экспорт
	// Точка с запятой перед КонецЕсли не обязательна.
	Оператор = Проверка.Оператор("Если А Тогда Х = 1 КонецЕсли");
	Проверка.Равно(Оператор.ИначеЕсли, Неопределено);
	Проверка.Равно(Оператор.Иначе, Неопределено);
КонецПроцедуры

Процедура ТестЦиклДля() Экспорт
	Оператор = Проверка.Оператор("Для Сч = 1 По 10 Цикл Продолжить; КонецЦикла;");
	Проверка.Равно(Оператор.Тип, "ОператорДля");
	Проверка.Равно(Оператор.Идентификатор.Голова.Имя, "Сч");
	Проверка.Равно(Оператор.Старт.Значение, 1);
	Проверка.Равно(Оператор.Финиш.Значение, 10);
	Проверка.Равно(Оператор.Операторы[0].Тип, "ОператорПродолжить");
КонецПроцедуры

Процедура ТестЦиклДляКаждого() Экспорт
	Оператор = Проверка.Оператор("Для Каждого Элемент Из Список Цикл Прервать; КонецЦикла;");
	Проверка.Равно(Оператор.Тип, "ОператорДляКаждого");
	Проверка.Равно(Оператор.Идентификатор.Голова.Имя, "Элемент");
	Проверка.Равно(Оператор.Коллекция.Голова.Имя, "Список");
	Проверка.Равно(Оператор.Операторы[0].Тип, "ОператорПрервать");
КонецПроцедуры

Процедура ТестЦиклПока() Экспорт
	Оператор = Проверка.Оператор("Пока Истина Цикл КонецЦикла;");
	Проверка.Равно(Оператор.Тип, "ОператорПока");
	Проверка.Равно(Оператор.Выражение.Значение, Истина);
	Проверка.Равно(Оператор.Операторы.Количество(), 0);
КонецПроцедуры

Процедура ТестВозврат() Экспорт
	Модуль = Проверка.Разобрать("Функция Ф() Возврат 1; КонецФункции Процедура П() Возврат; КонецПроцедуры");
	Проверка.Равно(Модуль.Объявления[0].Операторы[0].Тип, "ОператорВозврат");
	Проверка.Равно(Модуль.Объявления[0].Операторы[0].Выражение.Значение, 1);
	Проверка.Равно(Модуль.Объявления[1].Операторы[0].Выражение, Неопределено, "в процедуре Возврат без значения");
КонецПроцедуры

Процедура ТестПопытка() Экспорт
	Оператор = Проверка.Оператор("Попытка Ф(); Исключение ВызватьИсключение; КонецПопытки;");
	Проверка.Равно(Оператор.Тип, "ОператорПопытка");
	Проверка.Равно(Оператор.Попытка[0].Тип, "ОператорВызоваПроцедуры");
	Проверка.Равно(Оператор.Исключение.Тип, "ОператорИсключение");
	Повтор = Оператор.Исключение.Операторы[0];
	Проверка.Равно(Повтор.Тип, "ОператорВызватьИсключение");
	Проверка.Равно(Повтор.Выражение, Неопределено, "повторный выброс без текста");
	Проверка.Равно(Проверка.Оператор("ВызватьИсключение ""ошибка"";").Выражение.Тип, "ВыражениеСтроковое");
КонецПроцедуры

Процедура ТестПереходМеткаВыполнить() Экспорт
	Операторы = Проверка.Разобрать("Перейти ~Конец; ~Конец: Выполнить(""А = 1"");").Операторы;
	Проверка.Равно(Операторы[0].Тип, "ОператорПерейти");
	Проверка.Равно(Операторы[0].Метка, "Конец");
	Проверка.Равно(Операторы[1].Тип, "ОператорМетка");
	Проверка.Равно(Операторы[1].Метка, "Конец");
	Проверка.Равно(Операторы[2].Тип, "ОператорВыполнить");
КонецПроцедуры

Процедура ТестОбработчикиСобытий() Экспорт
	Операторы = Проверка.Разобрать("ДобавитьОбработчик А.Событие, Б; УдалитьОбработчик А.Событие, Б;").Операторы;
	Проверка.Равно(Операторы[0].Тип, "ОператорДобавитьОбработчик");
	Проверка.Равно(Операторы[1].Тип, "ОператорУдалитьОбработчик");
КонецПроцедуры

Процедура ТестАнглийскийСинтаксис() Экспорт
	Операторы = Проверка.Разобрать("If А Then Б = 1; ElsIf В Then Else EndIf; For Each Э In С Do EndDo;").Операторы;
	Проверка.Равно(Операторы[0].Тип, "ОператорЕсли");
	Проверка.Равно(Операторы[0].ИначеЕсли.Количество(), 1);
	Проверка.Равно(Операторы[1].Тип, "ОператорДляКаждого");
КонецПроцедуры

Проверка = Новый Проверка;
