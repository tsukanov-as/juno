// Парсер: переменные, процедуры и функции, директивы и аннотации.

Перем Проверка;
Перем Модуль;

Процедура ТестПеременныеМодуля() Экспорт
	Объявление = Модуль.Объявления[0];
	Проверка.Равно(Объявление.Тип, "ОбъявлениеСпискаПеременныхМодуля");
	Проверка.Равно(Объявление.Директивы[0].Директива, "НаКлиенте");
	Проверка.Равно(Объявление.Объявления.Количество(), 2);
	Проверка.Равно(Объявление.Объявления[0].Имя, "А");
	Проверка.Равно(Объявление.Объявления[0].Экспорт, Истина);
	Проверка.Равно(Объявление.Объявления[1].Экспорт, Ложь);
КонецПроцедуры

Процедура ТестСигнатураФункции() Экспорт
	Сигнатура = Модуль.Объявления[1].Сигнатура;
	Проверка.Равно(Сигнатура.Тип, "ОбъявлениеСигнатурыФункции");
	Проверка.Равно(Сигнатура.Имя, "Сумма");
	Проверка.Равно(Сигнатура.Экспорт, Истина);
	Проверка.Равно(Сигнатура.Асинх, Ложь);
	Проверка.Равно(Сигнатура.Директивы[0].Директива, "НаСервере");
КонецПроцедуры

Процедура ТестПараметры() Экспорт
	Параметры = Модуль.Объявления[1].Сигнатура.Параметры;
	Проверка.Равно(Параметры.Количество(), 2);
	Проверка.Равно(Параметры[0].Имя, "А");
	Проверка.Равно(Параметры[0].ПоЗначению, Истина, "Знач");
	Проверка.Равно(Параметры[1].ПоЗначению, Ложь);
	Проверка.Равно(Параметры[1].Значение.Значение, 5, "значение по умолчанию");
КонецПроцедуры

Процедура ТестТелоМетода() Экспорт
	Метод = Модуль.Объявления[1];
	Проверка.Равно(Метод.Объявления.Количество(), 1, "Перем Итог");
	Проверка.Равно(Метод.Операторы.Количество(), 3);
	// Переменные метода: объявленные через Перем и появившиеся при присваивании.
	Проверка.Равно(Метод.Переменные.Количество(), 2);
	Проверка.Равно(Метод.Переменные[0].Имя, "Итог");
	Проверка.Равно(Метод.Переменные[1].Имя, "Промежуточный");
КонецПроцедуры

Процедура ТестПроцедураСАннотацией() Экспорт
	Сигнатура = Модуль.Объявления[2].Сигнатура;
	Проверка.Равно(Сигнатура.Тип, "ОбъявлениеСигнатурыПроцедуры");
	Проверка.Равно(Сигнатура.Аннотации[0].Аннотация, "Перед");
	Проверка.Равно(Сигнатура.Аннотации[0].ИмяМетода, "Записать");
КонецПроцедуры

Процедура ТестТелоМодуля() Экспорт
	// Операторы после методов — тело модуля.
	Проверка.Равно(Модуль.Операторы.Количество(), 1);
	Проверка.Равно(Модуль.Операторы[0].Идентификатор.Голова.Имя, "Сообщить");
	Проверка.Равно(Модуль.Переменные.Количество(), 2, "переменные модуля А и Б");
КонецПроцедуры

Процедура ТестПозицииУзлов() Экспорт
	Сигнатура = Модуль.Объявления[1].Сигнатура;
	Проверка.Равно(Сигнатура.Начало.НомерСтроки, 4, "Функция на четвёртой строке");
	Проверка.Равно(Сигнатура.Начало.НомерКолонки, 1);
	Проверка.Равно(Модуль.Объявления[1].Конец.НомерСтроки, 9, "КонецФункции");
КонецПроцедуры

Проверка = Новый Проверка;
Модуль = Проверка.Разобрать(
	"&НаКлиенте
	|Перем А Экспорт, Б;
	|&НаСервере
	|Функция Сумма(Знач А, Б = 5) Экспорт
	|	Перем Итог;
	|	Промежуточный = А + Б;
	|	Итог = Промежуточный;
	|	Возврат Итог;
	|КонецФункции
	|&Перед(""Записать"")
	|Процедура ПередЗаписью()
	|КонецПроцедуры
	|Сообщить(1);");
