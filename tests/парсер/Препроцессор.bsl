// Парсер: инструкции препроцессора. Парсер их не вычисляет — они остаются в дереве как есть.

Перем Проверка;

Процедура ТестОбласть() Экспорт
	Модуль = Проверка.Разобрать("#Область Главная" + Символы.ПС + "#КонецОбласти");
	Проверка.Равно(Модуль.Объявления[0].Тип, "ИнструкцияПрепроцессораОбласть");
	Проверка.Равно(Модуль.Объявления[0].Имя, "Главная");
	// Инструкции до первого оператора модуля попадают в объявления, после — в операторы.
	Проверка.Равно(Модуль.Объявления[1].Тип, "ИнструкцияПрепроцессораКонецОбласти");
КонецПроцедуры

Процедура ТестЕслиСВыражением() Экспорт
	Инструкция = Проверка.Разобрать("#Если Сервер Или Не Клиент Тогда" + Символы.ПС + "#КонецЕсли").Объявления[0];
	Проверка.Равно(Инструкция.Тип, "ИнструкцияПрепроцессораЕсли");
	Условие = Инструкция.Выражение;
	Проверка.Равно(Условие.Тип, "ВыражениеПрепроцессораБинарное");
	Проверка.Равно(Условие.Операция.Токен, "Или");
	Проверка.Равно(Условие.ЛевыйОперанд.Символ, "Сервер");
	Проверка.Равно(Условие.ПравыйОперанд.Тип, "ВыражениеПрепроцессораНе");
КонецПроцедуры

Процедура ТестНеизвестныйСимвол() Экспорт
	Условие = Проверка.Разобрать("#Если Луна Тогда" + Символы.ПС + "#КонецЕсли").Объявления[0].Выражение;
	Проверка.Равно(Условие.Символ, "Луна");
	Проверка.Равно(Условие.Существует, Ложь);
	Проверка.Равно(Проверка.Разобрать("#Если Сервер Тогда" + Символы.ПС + "#КонецЕсли").Объявления[0].Выражение.Существует, Истина);
КонецПроцедуры

Процедура ТестВсеВетки() Экспорт
	Текст = "#Если Сервер Тогда
	|А = 1;
	|#ИначеЕсли ВебКлиент Тогда
	|А = 2;
	|#Иначе
	|А = 3;
	|#КонецЕсли";
	Модуль = Проверка.Разобрать(Текст);
	Типы = Новый Массив;
	Для Каждого Оператор Из Модуль.Операторы Цикл
		Типы.Добавить(Оператор.Тип);
	КонецЦикла;
	Проверка.Равно(СтрСоединить(Типы, ","),
		"ОператорПрисваивания,ИнструкцияПрепроцессораИначеЕсли,ОператорПрисваивания,"
		+ "ИнструкцияПрепроцессораИначе,ОператорПрисваивания,ИнструкцияПрепроцессораКонецЕсли");
КонецПроцедуры

Процедура ТестВнутриМетода() Экспорт
	Метод = Проверка.Разобрать(
		"Процедура П()
		|#Если Клиент Тогда
		|	Сообщить(1);
		|#КонецЕсли
		|КонецПроцедуры").Объявления[0];
	Проверка.Равно(Метод.Операторы.Количество(), 3);
	Проверка.Равно(Метод.Операторы[0].Тип, "ИнструкцияПрепроцессораЕсли");
КонецПроцедуры

Проверка = Новый Проверка;
