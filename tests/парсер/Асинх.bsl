// Парсер: Асинх и Ждать. Ключевые слова только в своём месте, в остальных — обычные имена.

Перем Проверка;

Процедура ТестАсинхМетод() Экспорт
	Модуль = Проверка.Разобрать("Асинх Функция Ф() Возврат 1; КонецФункции Процедура П() КонецПроцедуры");
	Проверка.Равно(Модуль.Объявления[0].Сигнатура.Асинх, Истина);
	Проверка.Равно(Модуль.Объявления[1].Сигнатура.Асинх, Ложь);
	// Асинх входит в объявление метода.
	Проверка.Равно(Модуль.Объявления[0].Начало.НомерКолонки, 1);
КонецПроцедуры

Процедура ТестЖдатьВВыражении() Экспорт
	Выражение = Проверка.Разобрать("Асинх Процедура П() Х = Ждать Г(); КонецПроцедуры").Объявления[0].Операторы[0].ПравыйОперанд;
	Проверка.Равно(Выражение.Тип, "ВыражениеЖдать");
	Проверка.Равно(Выражение.Выражение.Голова.Имя, "Г");
КонецПроцедуры

Процедура ТестЖдатьОператором() Экспорт
	Оператор = Проверка.Разобрать("Асинх Процедура П() Ждать Г(); КонецПроцедуры").Объявления[0].Операторы[0];
	Проверка.Равно(Оператор.Тип, "ОператорЖдать");
	Проверка.Равно(Оператор.Выражение.Тип, "ВыражениеЖдать");
КонецПроцедуры

Процедура ТестЖдатьИАсинхКакИмена() Экспорт
	Операторы = Проверка.Разобрать("Процедура П() Ждать = 1; Асинх = 2; КонецПроцедуры").Объявления[0].Операторы;
	Проверка.Равно(Операторы[0].ЛевыйОперанд.Голова.Имя, "Ждать");
	Проверка.Равно(Операторы[1].ЛевыйОперанд.Голова.Имя, "Асинх");
	// И в теле модуля, и в списке переменных модуля.
	Модуль = Проверка.Разобрать("Перем Асинх; Асинх Процедура Ждать() КонецПроцедуры Х = 1; Асинх = 3;");
	Проверка.Равно(Модуль.Объявления[1].Сигнатура.Имя, "Ждать");
	Проверка.Равно(Модуль.Операторы[1].ЛевыйОперанд.Голова.Имя, "Асинх");
КонецПроцедуры

Процедура ТестАнглийскийСинтаксис() Экспорт
	Метод = Проверка.Разобрать("Async Function F() Return Await G(); EndFunction").Объявления[0];
	Проверка.Равно(Метод.Сигнатура.Асинх, Истина);
	Проверка.Равно(Метод.Операторы[0].Выражение.Тип, "ВыражениеЖдать");
КонецПроцедуры

Процедура ТестОшибки() Экспорт
	// Внутри Асинх Ждать — оператор, присвоить ему нельзя.
	Ошибка = Проверка.ОшибкаРазбора("Асинх Процедура П() Ждать = 2; КонецПроцедуры");
	Проверка.Равно(Ошибка.Код, 7);
	Проверка.Равно(Ошибка.Колонка, 27);
	Проверка.Равно(Проверка.ОшибкаРазбора("Асинх Перем Х;").Текст, "Ожидается определение процедуры/функции");
	Проверка.Равно(Проверка.ОшибкаРазбора("Асинх Функция Ф() Х = Ждать Ждать Ф(); КонецФункции").Код, 11);
КонецПроцедуры

Проверка = Новый Проверка;
