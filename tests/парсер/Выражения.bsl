// Парсер: литералы, приоритет операций, вызовы и обращения через точку.

Перем Проверка;

Процедура ТестЧисла() Экспорт
	Число = Проверка.Выражение("12.50");
	Проверка.Равно(Число.Тип, "ВыражениеЛитерал");
	Проверка.Равно(Число.Вид, "Число");
	Проверка.Равно(Число.Значение, 12.5);
КонецПроцедуры

Процедура ТестДатыБулевоНеопределеноNull() Экспорт
	Проверка.Равно(Проверка.Выражение("'20261015'").Значение, '20261015');
	Проверка.Равно(Проверка.Выражение("Истина").Значение, Истина);
	Проверка.Равно(Проверка.Выражение("Ложь").Вид, "Ложь");
	Проверка.Равно(Проверка.Выражение("Неопределено").Вид, "Неопределено");
	Проверка.Равно(Проверка.Выражение("NULL").Вид, "Null");
КонецПроцедуры

Процедура ТестСтроки() Экспорт
	Строка = Проверка.Выражение("""текст""");
	Проверка.Равно(Строка.Тип, "ВыражениеСтроковое");
	Проверка.Равно(Строка.Элементы[0].Вид, "Строка");
	Проверка.Равно(Строка.Элементы[0].Значение, "текст");
	Проверка.Равно(Проверка.Выражение("""а"" ""б""").Элементы.Количество(), 2, "строка из двух частей");
КонецПроцедуры

Процедура ТестМногострочнаяСтрока() Экспорт
	Строка = Проверка.Выражение("""первая" + Символы.ПС + "|вторая""");
	Проверка.Равно(Строка.Элементы.Количество(), 2);
	Проверка.Равно(Строка.Элементы[0].Вид, "НачалоСтроки");
	Проверка.Равно(Строка.Элементы[1].Вид, "ОкончаниеСтроки");
КонецПроцедуры

Процедура ТестУмножениеРаньшеСложения() Экспорт
	Выражение = Проверка.Выражение("1 + 2 * 3");
	Проверка.Равно(Выражение.Тип, "ВыражениеБинарное");
	Проверка.Равно(Выражение.Операция.Токен, "ЗнакСложения");
	Проверка.Равно(Выражение.ПравыйОперанд.Операция.Токен, "ЗнакУмножения");
КонецПроцедуры

Процедура ТестСкобкиМеняютПорядок() Экспорт
	Выражение = Проверка.Выражение("(1 + 2) * 3");
	Проверка.Равно(Выражение.Операция.Токен, "ЗнакУмножения");
	Проверка.Равно(Выражение.ЛевыйОперанд.Тип, "ВыражениеСкобочное");
	Проверка.Равно(Выражение.ЛевыйОперанд.Выражение.Операция.Токен, "ЗнакСложения");
КонецПроцедуры

Процедура ТестУнарныйМинусСильнееУмножения() Экспорт
	Выражение = Проверка.Выражение("-А * 2");
	Проверка.Равно(Выражение.Операция.Токен, "ЗнакУмножения");
	Проверка.Равно(Выражение.ЛевыйОперанд.Тип, "ВыражениеУнарное");
	Проверка.Равно(Выражение.ЛевыйОперанд.Операция.Токен, "ЗнакВычитания");
КонецПроцедуры

Процедура ТестЗнакиОпераций() Экспорт
	Знаки = Новый Соответствие;
	Знаки.Вставить("=", "ЗнакРавно");
	Знаки.Вставить("<>", "ЗнакНеРавно");
	Знаки.Вставить("<", "ЗнакМеньше");
	Знаки.Вставить(">", "ЗнакБольше");
	Знаки.Вставить("<=", "ЗнакМеньшеИлиРавно");
	Знаки.Вставить(">=", "ЗнакБольшеИлиРавно");
	Знаки.Вставить("-", "ЗнакВычитания");
	Знаки.Вставить("/", "ЗнакДеления");
	Знаки.Вставить("%", "ЗнакОстатка");
	Для Каждого Знак Из Знаки Цикл
		Проверка.Равно(Проверка.Выражение("А " + Знак.Ключ + " Б").Операция.Токен, Знак.Значение, Знак.Ключ);
	КонецЦикла;
КонецПроцедуры

Процедура ТестЛогическиеОперации() Экспорт
	// Не связывает сильнее И, а И — сильнее Или.
	Выражение = Проверка.Выражение("Не А И Б Или В");
	Проверка.Равно(Выражение.Операция.Токен, "Или");
	Проверка.Равно(Выражение.ЛевыйОперанд.Операция.Токен, "И");
	Проверка.Равно(Выражение.ЛевыйОперанд.ЛевыйОперанд.Тип, "ВыражениеНе");
КонецПроцедуры

Процедура ТестТернарныйОператор() Экспорт
	Выражение = Проверка.Выражение("?(А, 1, 2)");
	Проверка.Равно(Выражение.Тип, "ВыражениеТернарное");
	Проверка.Равно(Выражение.Выражение.Голова.Имя, "А");
	Проверка.Равно(Выражение.Тогда.Значение, 1);
	Проверка.Равно(Выражение.Иначе.Значение, 2);
КонецПроцедуры

Процедура ТестНовый() Экспорт
	Выражение = Проверка.Выражение("Новый Массив(3)");
	Проверка.Равно(Выражение.Тип, "ВыражениеНовый");
	Проверка.Равно(Выражение.Имя, "Массив");
	Проверка.Равно(Выражение.Аргументы.Количество(), 1);
	// Тип можно передать значением: Новый (Тип, Параметры).
	Выражение = Проверка.Выражение("Новый (""Массив"", Параметры)");
	Проверка.Равно(Выражение.Имя, Неопределено);
	Проверка.Равно(Выражение.Аргументы.Количество(), 2);
КонецПроцедуры

Процедура ТестЦепочкаОбращений() Экспорт
	Выражение = Проверка.Выражение("Объект.Поле.Метод(1)[2]");
	Проверка.Равно(Выражение.Тип, "ВыражениеИдентификатор");
	Проверка.Равно(Выражение.Голова.Имя, "Объект");
	Проверка.Равно(Выражение.Хвост.Количество(), 3);
	Проверка.Равно(Выражение.Хвост[0].Тип, "ВыражениеПоле");
	Проверка.Равно(Выражение.Хвост[0].Аргументы, Неопределено, "поле — не вызов");
	Проверка.Равно(Выражение.Хвост[1].Имя, "Метод");
	Проверка.Равно(Выражение.Хвост[1].Аргументы.Количество(), 1);
	Проверка.Равно(Выражение.Хвост[2].Тип, "ВыражениеИндекс");
КонецПроцедуры

Процедура ТестВызовы() Экспорт
	Проверка.Равно(Проверка.Выражение("Ф").Аргументы, Неопределено, "не вызов");
	Проверка.Равно(Проверка.Выражение("Ф()").Аргументы.Количество(), 0);
	// Пропущенный аргумент остаётся на своём месте.
	Вызов = Проверка.Выражение("Ф(1, , 3)");
	Проверка.Равно(Вызов.Аргументы.Количество(), 3);
	Проверка.Равно(Вызов.Аргументы[1], Неопределено);
КонецПроцедуры

Процедура ТестАнглийскийСинтаксис() Экспорт
	Выражение = Проверка.Выражение("Not А And Б Or В");
	Проверка.Равно(Выражение.Операция.Токен, "Или");
	Проверка.Равно(Выражение.ЛевыйОперанд.ЛевыйОперанд.Тип, "ВыражениеНе");
КонецПроцедуры

Процедура ТестКлассСПространствомИмён() Экспорт
	// Новый Справочники.Товар — расширение juno; в языке платформы такой записи нет.
	Парсер = Новый Парсер;
	Парсер.РасширенияJuno = Истина;
	Выражение = Парсер.Разобрать("Х = Новый Справочники.Товар;").Операторы[0].ПравыйОперанд;
	Проверка.Равно(Выражение.Имя, "Справочники.Товар");
	Проверка.Равно(Проверка.ОшибкаРазбора("Х = Новый Справочники.Товар;").Текст, "Ожидался оператор или объявление; проверьте имя и положение ключевого слова: .");
КонецПроцедуры

Проверка = Новый Проверка;
