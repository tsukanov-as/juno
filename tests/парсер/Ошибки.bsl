// Парсер: синтаксические ошибки — код, место и текст — и таблица токенов.

Перем Проверка;

Процедура Ошибка(Текст, Код, Колонка, Сообщение)
	Ошибка = Проверка.ОшибкаРазбора(Текст);
	Проверка.Равно(Ошибка.Код, Код, Текст);
	Проверка.Равно(Ошибка.Строка, 1, Текст);
	Проверка.Равно(Ошибка.Колонка, Колонка, Текст);
	Проверка.Равно(Ошибка.Текст, Сообщение, Текст);
КонецПроцедуры

Процедура ТестНезакрытыйБлок() Экспорт
	Ошибка("Если А Тогда", 1, 13, "Ожидалось: КонецЕсли");
	Ошибка("Процедура П() КонецФункции", 1, 15, "Ожидалось: КонецПроцедуры");
КонецПроцедуры

Процедура ТестНетОперанда() Экспорт
	Ошибка("А = ;", 7, 5, "Ожидался операнд");
	Ошибка("#Если Тогда" + Символы.ПС + "#КонецЕсли", 7, 7, "Ожидался операнд");
КонецПроцедуры

Процедура ТестЛитералы() Экспорт
	Ошибка("Х = ""незакрытая", 1, 16, "Ожидалось: """);
	Ошибка("Х = '2026';", 18, 5, "Ошибка в литерале даты: 2026");
КонецПроцедуры

Процедура ТестПовторныеОбъявления() Экспорт
	Ошибка("Функция Ф() КонецФункции Функция Ф() КонецФункции", 13, 34, "Повторное объявление метода: Ф");
	Ошибка("Перем А; Перем А;", 12, 16, "Повторное объявление идентификатора: А");
КонецПроцедуры

Процедура ТестНеизвестнаяДиректива() Экспорт
	Ошибка("&НаЛуне Процедура П() КонецПроцедуры", 3, 1, "Неизвестная директива: НаЛуне");
КонецПроцедуры

Процедура ТестТаблицаТокенов() Экспорт
	Парсер = Новый Парсер;
	Парсер.Разобрать("Если А Тогда // комментарий" + Символы.ПС + "  Б = 1; КонецЕсли;");
	Токены = Парсер.ТаблицаТокенов();
	Проверка.Равно(Токены[0].Токен, "НачалоТекста");
	Проверка.Равно(Токены[4].Токен, "Комментарий", "комментарии тоже токены");
	Проверка.Равно(Токены[5].Токен, "Идентификатор");
	Проверка.Равно(Токены[5].НомерСтроки, 2);
	Проверка.Равно(Токены[5].НомерКолонки, 3);
	Проверка.Равно(Токены[Токены.Количество() - 1].Токен, "КонецТекста");
КонецПроцедуры

Процедура ТестАнглийскиеКлючевыеСлова() Экспорт
	Парсер = Новый Парсер;
	Токены = Парсер.Токенизировать("If А Then");
	Проверка.Равно(Токены[1].Токен, "Если");
КонецПроцедуры

Проверка = Новый Проверка;
