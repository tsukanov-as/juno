// Вспомогательный модуль для тестов модулей: класс язык.Счетчик.

Перем Значение Экспорт;
Перем Шаг;

Процедура Увеличить() Экспорт
	Значение = Значение + Шаг;
КонецПроцедуры

Процедура УстановитьШаг(Знач НовыйШаг) Экспорт
	Шаг = НовыйШаг;
	НовыйШаг = 0; // параметр Знач — изменение не видно снаружи
КонецПроцедуры

Процедура Обнулить(Число) Экспорт
	Число = 0; // параметр без Знач — изменение видно снаружи
КонецПроцедуры

// Новый язык.Счетчик(10, 5): вызывается после тела модуля.
Процедура ПриСозданииОбъекта(Начало = 0, НовыйШаг = 1)
	Значение = Начало;
	Шаг = НовыйШаг;
КонецПроцедуры

Функция Удвоить(Число, Множитель = 2) Экспорт
	Возврат Число * Множитель;
КонецФункции

Значение = 0;
Шаг = 1;
