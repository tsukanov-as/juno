Перем Проверка;

// Для Каждого обходит Массив, СписокЗначений, ТаблицаЗначений, строки и колонки по позиции, глядя на размер
// на каждом шаге (как 1С 8.3.27.1606): добавленные элементы посещаются, после удаления текущего следующий
// пропускается, Очистить завершает цикл. Ожидания сняты запуском тех же циклов на платформе.

Функция Массив(Знач Числа = "1,2,3,4")
    М = Новый Массив;
    Для Каждого Ч Из СтрРазделить(Числа, ",") Цикл М.Добавить(Число(Ч)); КонецЦикла;
    Возврат М;
КонецФункции

Функция Список()
    С = Новый СписокЗначений;
    Для Каждого Ч Из Массив() Цикл С.Добавить(Ч); КонецЦикла;
    Возврат С;
КонецФункции

Функция Таблица()
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("а");
    Для Каждого Ч Из Массив() Цикл Т.Добавить().а = Ч; КонецЦикла;
    Возврат Т;
КонецФункции

Функция Дерево()
    Д = Новый ДеревоЗначений;
    Д.Колонки.Добавить("а");
    Для Каждого Ч Из Массив() Цикл Д.Строки.Добавить().а = Ч; КонецЦикла;
    Возврат Д;
КонецФункции

Функция Итог(Видели)
    Возврат СтрСоединить(Видели, ",");
КонецФункции

Процедура ТестМассивДобавлениеВидноВЦикле() Экспорт
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 1 Тогда М.Добавить(9); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,3,4,9");
    // очередь: обработанный элемент порождает следующий
    М = Массив("1"); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э < 5 Тогда М.Добавить(Э + 10); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,11");
КонецПроцедуры

Процедура ТестМассивУдалениеСдвигаетОбход() Экспорт
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 2 Тогда М.Удалить(1); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,4");
    Проверка.Равно(Итог(М), "1,3,4");
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 1 Тогда М.Удалить(0); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,3,4");
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 1 Тогда М.Удалить(3); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,3");
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 1 Тогда М.Удалить(3); М.Удалить(2); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2");
КонецПроцедуры

Процедура ТестМассивВставкаОчисткаИЗамена() Экспорт
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 2 Тогда М.Вставить(2, 7); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,7,3,4");
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 2 Тогда М.Очистить(); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2");
    Проверка.Равно(М.Количество(), 0);
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 1 Тогда М.Установить(2, 99); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,99,4");
КонецПроцедуры

Процедура ТестМассивБесконечноеДобавлениеНеПадает() Экспорт
    // вставка в начало при каждом посещении двойки зацикливает обход, как и в 1С: прерываем сами
    М = Массив(); Видели = Новый Массив;
    Для Каждого Э Из М Цикл
        Видели.Добавить(Э);
        Если Э = 2 Тогда М.Вставить(0, 7); КонецЕсли;
        Если Видели.Количество() = 6 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,2,2,2,2");
    Проверка.Равно(М.Количество(), 9);
КонецПроцедуры

Процедура ТестСписокЗначенийМенятсяВЦикле() Экспорт
    С = Список(); Видели = Новый Массив;
    Для Каждого Э Из С Цикл
        Видели.Добавить(Э.Значение);
        Если Э.Значение = 1 Тогда С.Добавить(9); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,3,4,9");
    С = Список(); Видели = Новый Массив;
    Для Каждого Э Из С Цикл
        Видели.Добавить(Э.Значение);
        Если Э.Значение = 2 Тогда С.Удалить(Э); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,4");
    Проверка.Равно(С.Количество(), 3);
    С = Список(); Видели = Новый Массив;
    Для Каждого Э Из С Цикл
        Видели.Добавить(Э.Значение);
        Если Э.Значение = 2 Тогда С.Очистить(); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2");
КонецПроцедуры

Процедура ТестТаблицаЗначенийМенятсяВЦикле() Экспорт
    Т = Таблица(); Видели = Новый Массив;
    Для Каждого Э Из Т Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 1 Тогда Т.Добавить().а = 9; КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,3,4,9");
    Т = Таблица(); Видели = Новый Массив;
    Для Каждого Э Из Т Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 2 Тогда Т.Удалить(Э); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,4");
    Т = Таблица(); Видели = Новый Массив;
    Для Каждого Э Из Т Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 1 Тогда Т.Удалить(1); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,3,4");
    Т = Таблица(); Видели = Новый Массив;
    Для Каждого Э Из Т Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 2 Тогда Т.Очистить(); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2");
    // сортировка в цикле переставляет строки под курсором
    Т = Таблица(); Видели = Новый Массив;
    Для Каждого Э Из Т Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 1 Тогда Т.Сортировать("а Убыв"); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,3,2,1");
КонецПроцедуры

Процедура ТестСтрокиДереваИКолонкиМенятсяВЦикле() Экспорт
    Д = Дерево(); Видели = Новый Массив;
    Для Каждого Э Из Д.Строки Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 1 Тогда Д.Строки.Добавить().а = 9; КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,3,4,9");
    Д = Дерево(); Видели = Новый Массив;
    Для Каждого Э Из Д.Строки Цикл
        Видели.Добавить(Э.а);
        Если Э.а = 2 Тогда Д.Строки.Удалить(Э); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "1,2,4");
    Т = Новый ТаблицаЗначений; Т.Колонки.Добавить("а"); Т.Колонки.Добавить("б"); Видели = Новый Массив;
    Для Каждого Колонка Из Т.Колонки Цикл
        Видели.Добавить(Колонка.Имя);
        Если Колонка.Имя = "а" Тогда Т.Колонки.Добавить("в"); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "а,б,в");
КонецПроцедуры

Процедура ТестСтруктураИСоответствиеОбходятсяПоСнимку() Экспорт
    С = Новый Структура("а,б,в"); Видели = Новый Массив;
    Для Каждого Э Из С Цикл
        Видели.Добавить(Э.Ключ);
        Если Э.Ключ = "а" Тогда С.Вставить("г", 4); С.Удалить("б"); КонецЕсли;
    КонецЦикла;
    Проверка.Равно(Итог(Видели), "а,б,в");
    Проверка.Равно(С.Количество(), 3);
КонецПроцедуры

Проверка = Новый Проверка;
