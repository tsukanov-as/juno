Перем Проверка;

Процедура ТестБулево() Экспорт
    Проверка.Равно(Булево(1), Истина);
    Проверка.Равно(Boolean(-2), Истина);
    Проверка.Равно(Булево(0), Ложь);
    Проверка.Равно(Булево("Истина"), Истина);
    Проверка.Равно(Булево("дА"), Истина);
    Проверка.Равно(Boolean("False"), Ложь);
    Проверка.Равно(Булево("Нет"), Ложь);
    Для Каждого Текст Из СтрРазделить("1, Да ,", ",") Цикл
        Ошибка = Ложь;
        Попытка Результат = Булево(Текст);
        Исключение Ошибка = Истина; КонецПопытки;
        Проверка.Проверить(Ошибка);
    КонецЦикла;
КонецПроцедуры

Процедура ТестЗаполненность() Экспорт
    Проверка.Проверить(Не ЗначениеЗаполнено(Неопределено));
    Проверка.Проверить(Не ЗначениеЗаполнено(Null));
    Проверка.Проверить(Не ЗначениеЗаполнено(0));
    Проверка.Проверить(ValueIsFilled(Ложь));
    Проверка.Проверить(Не ЗначениеЗаполнено(" " + Символ(160)));
    Проверка.Проверить(Не ЗначениеЗаполнено(Дата(1,1,1)));
    Проверка.Проверить(ЗначениеЗаполнено(Дата(1,1,1,0,0,1)));
    М = Новый Массив;
    Проверка.Проверить(Не ЗначениеЗаполнено(М));
    М.Добавить(Неопределено);
    Проверка.Проверить(ЗначениеЗаполнено(М));
    Проверка.Проверить(Не ЗначениеЗаполнено(Новый Структура));
    Проверка.Проверить(ЗначениеЗаполнено(Новый Структура("Поле")));
    Проверка.Проверить(ЗначениеЗаполнено(Тип("Число")));
КонецПроцедуры

Процедура ТестXMLПримитивы() Экспорт
    Проверка.Равно(XMLСтрока(1234.500), "1234.5");
    Проверка.Равно(XMLString(Истина), "true");
    Проверка.Равно(XMLСтрока(Ложь), "false");
    Проверка.Равно(XMLСтрока(Неопределено), "");
    Проверка.Равно(XMLСтрока(Null), "");
    Проверка.Равно(XMLСтрока("<&x>"), "<&x>");
    Проверка.Равно(XMLЗначение(Тип("String"), "&lt;x&gt;"), "&lt;x&gt;", "лексическое значение не декодирует разметку");
    Проверка.Равно(XMLValue(Тип("Number"), " +.5 "), 0.5);
    Проверка.Равно(XMLЗначение(Тип("Число"), "5."), 5);
    Проверка.Равно(XMLЗначение(Тип("Булево"), " true "), Истина);
    Проверка.Равно(XMLValue(Тип("Boolean"), "0"), Ложь);
    Проверка.Равно(XMLЗначение(Тип("Неопределено"), ""), Неопределено);
    Проверка.Равно(XMLЗначение(Тип("Null"), ""), Null);
    Большое = 12345678901234567890123456789012345678.0012300;
    Проверка.Равно(XMLValue(Тип("Number"), XMLString(Большое)), Большое);
    Проверка.Равно(XMLString(Большое), "12345678901234567890123456789012345678.00123");
КонецПроцедуры

Процедура ТестXMLДаты() Экспорт
    Д = Дата(2024, 2, 29, 13, 4, 5) + 0.123456789;
    Проверка.Равно(XMLString(Д), "2024-02-29T13:04:05.123456789");
    Проверка.Равно(XMLValue(Тип("Date"), XMLString(Д)), Д);
    Проверка.Равно(XMLЗначение(Тип("Дата"), "2024-02-29"), Дата(2024,2,29));
    Проверка.Равно(XMLСтрока(Дата(1,1,1)), "0001-01-01T00:00:00");
    Проверка.Равно(XMLЗначение(Тип("Дата"), "9999-12-31T23:59:59"), Дата(9999,12,31,23,59,59));
КонецПроцедуры

Процедура НеверныйXML(ИмяТипа, Текст)
    Ошибка = Ложь;
    Попытка Результат = XMLЗначение(Тип(ИмяТипа), Текст);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка, ИмяТипа + ": " + Текст);
КонецПроцедуры

Процедура ТестОшибкиXML() Экспорт
    НеверныйXML("Число", "1,25");
    НеверныйXML("Число", "1e3");
    НеверныйXML("Число", "NaN");
    НеверныйXML("Булево", "TRUE");
    НеверныйXML("Булево", "Да");
    НеверныйXML("Дата", "2023-02-29T00:00:00");
    НеверныйXML("Дата", "2024-02-29T00:00:00+03:00");
    НеверныйXML("Дата", "2024-02-29T00:00:00Z");
    НеверныйXML("Дата", "2024-02-29T00:00:00.1234567891");
    НеверныйXML("Дата", "0000-01-01T00:00:00");
    НеверныйXML("Неопределено", "x");
    НеверныйXML("Массив", "");
КонецПроцедуры

Проверка = Новый Проверка;
