// Язык: ветвления, циклы, переходы.

Перем Проверка;
Перем Вызовов;

Процедура ТестЕсли() Экспорт
	Для Каждого Пара Из СтрРазделить("1:один,2:два,3:много", ",") Цикл
		Число = Число(Лев(Пара, 1));
		Если Число = 1 Тогда
			Слово = "один";
		ИначеЕсли Число = 2 Тогда
			Слово = "два";
		Иначе
			Слово = "много";
		КонецЕсли;
		Проверка.Равно(Слово, Сред(Пара, 3));
	КонецЦикла;
	Проверка.Равно(?(2 > 1, "да", "нет"), "да");
КонецПроцедуры

Процедура ТестЦиклы() Экспорт
	Сумма = 0;
	Для Сч = 1 По 10 Цикл
		Если Сч % 2 = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Сч > 7 Тогда
			Прервать;
		КонецЕсли;
		Сумма = Сумма + Сч;
	КонецЦикла;
	Проверка.Равно(Сумма, 1 + 3 + 5 + 7);
	Сч = 0;
	Пока Сч < 5 Цикл
		Сч = Сч + 1;
	КонецЦикла;
	Проверка.Равно(Сч, 5);
КонецПроцедуры

Процедура ТестПерейти() Экспорт
	Шаги = 0;
	~Снова:
	Шаги = Шаги + 1;
	Если Шаги < 3 Тогда
		Перейти ~Снова;
	КонецЕсли;
	Проверка.Равно(Шаги, 3);
КонецПроцедуры

Процедура ТестКороткоеВычисление() Экспорт
	// Правая часть И / Или не вычисляется, если результат уже известен.
	Вызовов = 0;
	Если Ложь И Отметить() Тогда
	КонецЕсли;
	Если Истина Или Отметить() Тогда
	КонецЕсли;
	Проверка.Равно(Вызовов, 0);
КонецПроцедуры

Функция Отметить()
	Вызовов = Вызовов + 1;
	Возврат Истина;
КонецФункции

Проверка = Новый Проверка;
