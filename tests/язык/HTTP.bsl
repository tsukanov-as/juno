    Проверка.Равно(ТипЗнч(ByteOrderMarkUsage.Auto), Тип("ИспользованиеByteOrderMark"));
    З = Новый HTTPЗапрос("/v1?q=%D1%91");
    Проверка.Равно(З.АдресРесурса,"/v1?q=%D1%91");
    Проверка.Равно(З.ПолучитьТелоКакСтроку(), Неопределено);
