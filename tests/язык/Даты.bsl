Перем Проверка;

Процедура ТестРазностьДалекихДат() Экспорт
	Начало = Дата(1, 1, 1);
	Конец = Дата(2026, 1, 1);
	Проверка.Равно(Конец - Начало, 63902822400);
	Проверка.Равно(Начало - Конец, -63902822400);
	Проверка.Равно(Дата(9999, 12, 31, 23, 59, 59) - Начало, 315537897599);
	Проверка.Равно((Конец + 0.5) - Начало, 63902822400.5);
	Проверка.Равно(Начало - (Конец + 0.5), -63902822400.5);
КонецПроцедуры

Процедура ТестБольшоеСмещениеДаты() Экспорт
	Начало = Дата(1, 1, 1);
	Конец = Дата(2026, 1, 1);
	Проверка.Равно(Начало + 63902822400, Конец);
	Проверка.Равно(Конец - 63902822400, Начало);
	Проверка.Равно(Начало - (-63902822400), Конец);
	Проверка.Равно(Конец + (-63902822400), Начало);
	Проверка.Равно(Начало + 315537897599, Дата(9999, 12, 31, 23, 59, 59));
	Проверка.Равно((Начало + 63902822400.25) - Конец, 0.25);
	Проверка.Равно((Конец - 63902822399.75) - Начало, 0.25);
	Проверка.Равно((Конец - 0.5) - Конец, -0.5);
КонецПроцедуры

Процедура ТестЧастиИГраницыДаты() Экспорт
    Д = Дата(2024, 2, 29, 13, 4, 5) + 0.125;
    Проверка.Равно(Год(Д), 2024);
    Проверка.Равно(Month(Д), 2);
    Проверка.Равно(День(Д), 29);
    Проверка.Равно(Hour(Д), 13);
    Проверка.Равно(Минута(Д), 4);
    Проверка.Равно(Second(Д), 5);
    Проверка.Равно(НачалоДня(Д), Дата(2024,2,29));
    Проверка.Равно(EndOfDay(Д), Дата(2024,2,29,23,59,59));
    Проверка.Равно(BegOfMonth(Д), Дата(2024,2,1));
    Проверка.Равно(КонецМесяца(Д), Дата(2024,2,29,23,59,59));
    Проверка.Равно(КонецМесяца(Дата(2023,2,1)), Дата(2023,2,28,23,59,59));
    Проверка.Равно(КонецМесяца(Дата(9999,12,1)), Дата(9999,12,31,23,59,59));
    Проверка.Равно(Year("20240229"), 2024);
КонецПроцедуры

Процедура ТестДобавитьМесяц() Экспорт
    Проверка.Равно(ДобавитьМесяц(Дата(2024,1,31,13,4,5),1), Дата(2024,2,29,13,4,5));
    Проверка.Равно(AddMonth(Дата(2023,1,31),1), Дата(2023,2,28));
    Проверка.Равно(ДобавитьМесяц(Дата(2024,3,31),-1), Дата(2024,2,29));
    Проверка.Равно(ДобавитьМесяц(Дата(2024,12,31),2), Дата(2025,2,28));
    Проверка.Равно(ДобавитьМесяц(Дата(2024,1,31),1.9), Дата(2024,2,29));
    Проверка.Равно(ДобавитьМесяц(Дата(2024,1,31)+0.25,1)-Дата(2024,2,29), 0.25);
КонецПроцедуры

Процедура ТестТекущаяДата() Экспорт
    Проверка.Равно(ТипЗнч(ТекущаяДата()), Тип("Дата"));
    Проверка.Равно(ТипЗнч(CurrentUniversalDate()), Тип("Дата"));
    Проверка.Проверить(Год(CurrentDate()) >= 2024);
    Д = ТекущаяУниверсальнаяДата();
    Проверка.Равно(Д - НачалоДня(Д), Цел(Д - НачалоДня(Д)));
КонецПроцедуры

Процедура ТестДиапазонДат() Экспорт
    Ошибка = Ложь;
    Попытка Результат = Дата(0,1,1);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = Дата(10000,1,1);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = Дата(1,1,1) - 1;
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = Дата(9999,12,31,23,59,59) + 1;
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = ДобавитьМесяц(Дата(1,1,1),-1);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = Дата("20230229");
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка, "невозможная календарная дата не нормализуется");
    Проверка.Равно(Дата("00000000"), Дата(1,1,1));
КонецПроцедуры

Проверка = Новый Проверка;
