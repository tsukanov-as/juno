Перем Проверка;

Функция Каталог()
    Путь = ПолучитьИмяВременногоФайла("test");
    СоздатьКаталог(Путь);
    Возврат Путь;
КонецФункции

Функция Hex(Путь)
    Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь));
КонецФункции

Процедура ТестФайлИВиртуальныйКаталог() Экспорт
    Исходный = CurrentDirectory();
    Временный = Каталог();
    SetCurrentDirectory(Временный);
    Ф = Новый File("a.txt");
    З = Новый TextWriter("a.txt"); З.Write("A"); З.Close();
    Проверка.Равно(Ф.Name, "a.txt");
    Проверка.Равно(Ф.ИмяБезРасширения, "a");
    Проверка.Равно(Ф.BaseName, "a");
    Проверка.Равно(Ф.Extension, ".txt");
    Проверка.Равно(Ф.Path, "");
    Проверка.Равно(Ф.FullName, CombinePath(Временный, "a.txt"));
    Проверка.Проверить(Ф.Exist());
    Проверка.Проверить(Ф.IsFile());
    Проверка.Проверить(Не Ф.IsDirectory());
    Проверка.Равно(Ф.Size(), 4);
    Д = Дата(2024,2,29,12,0,0);
    Ф.SetModificationTime(Д);
    Проверка.Равно(Ф.GetModificationTime(), Д);
    Ф.SetReadOnly(Истина);
    Проверка.Проверить(Ф.GetReadOnly());
    Ф.SetReadOnly(Ложь);
    Абсолютный = Новый Файл(Ф.FullName);
    CreateDirectory("other"); SetCurrentDirectory("other");
    Проверка.Проверить(Не Ф.Exist(), "относительный Файл следует текущему каталогу");
    Проверка.Проверить(Абсолютный.Exist());
    SetCurrentDirectory(Исходный);
    Проверка.Равно(ТипЗнч(Ф), Тип("File"));
    УдалитьФайлы(Временный);
КонецПроцедуры

Процедура ТестБайтыКодировок() Экспорт
    Временный = Каталог();
    Путь = ОбъединитьПути(Временный,"out.txt");
    Кодировки = Новый Массив;
    Кодировки.Добавить(КодировкаТекста.UTF8); Кодировки.Добавить(КодировкаТекста.UTF16);
    Кодировки.Добавить(КодировкаТекста.ANSI); Кодировки.Добавить(КодировкаТекста.OEM); Кодировки.Добавить(КодировкаТекста.Системная);
    Ожидания = Новый Массив;
    Ожидания.Добавить("EFBBBFD09FD180D0B8D0B2D0B5D18220D191D08120E284960D0AD09CD0B8D1800D0A");
    Ожидания.Добавить("FFFE1F0440043804320435044204200051040104200016210D000A001C04380440040D000A00");
    Ожидания.Добавить("CFF0E8E2E5F220B8A820B90D0ACCE8F00D0A");
    Ожидания.Добавить("8FE0A8A2A5E220F1F020FC0D0A8CA8E00D0A");
    Ожидания.Добавить(Ожидания[0]);
    Для Индекс = 0 По Кодировки.Количество()-1 Цикл
        З = Новый ЗаписьТекста(Путь, Кодировки[Индекс]);
        З.Записать("Привет ёЁ №" + Символы.ПС); З.ЗаписатьСтроку("Мир"); З.Закрыть();
        Проверка.Равно(Hex(Путь), Ожидания[Индекс]);
        Ч = Новый ЧтениеТекста(Путь, Кодировки[Индекс]);
        Проверка.Равно(Ч.ПрочитатьСтроку(), "Привет ёЁ №");
        Проверка.Равно(Ч.ПрочитатьСтроку(), "Мир");
        Проверка.Равно(Ч.ПрочитатьСтроку(), Неопределено); Ч.Закрыть();
    КонецЦикла;
    Проверка.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки("ё",КодировкаТекста.UTF16)),"5104");
    УдалитьФайлы(Временный);
КонецПроцедуры

Процедура ТестДописываниеИКонецТекста() Экспорт
    Временный = Каталог(); Путь = CombinePath(Временный,"out.txt");
    З = Новый ЗаписьТекста(Путь); З.Записать("A"); З.Закрыть(); З.Закрыть();
    З.Открыть(Путь,,,Истина); З.Записать("B"); З.ЗаписатьСтроку(""); З.ЗаписатьСтроку(""); З.Закрыть();
    Проверка.Равно(Hex(Путь),"EFBBBF41420D0A0D0A");
    Ч = Новый ЧтениеТекста; Ч.Открыть(Путь);
    Проверка.Равно(Ч.ПрочитатьСтроку(), "AB");
    Проверка.Равно(Ч.ReadLine(), "");
    Проверка.Равно(Ч.ReadLine(), Неопределено); Ч.Close(); Ч.Close();
    З = Новый TextWriter(Путь,TextEncoding.UTF8NoBOM,"|"); З.WriteLine("A"); З.Write("B"); З.Close();
    Проверка.Равно(Hex(Путь),"417C42");
    Ч = Новый TextReader(Путь,,"|");
    Проверка.Равно(Ч.ReadLine(),"A"); Проверка.Равно(Ч.Read(1),"B"); Проверка.Равно(Ч.Read(),Неопределено); Ч.Close();
    ПолучитьДвоичныеДанныеИзHexСтроки("EFBBBF410D0A420D43").Записать(Путь);
    Ч = Новый TextReader(Путь,TextEncoding.ANSI);
    Проверка.Равно(Ч.Read(),"A"+Символы.ПС+"B"+Символы.ПС+"C"); Ч.Close();
    УдалитьФайлы(Временный);
КонецПроцедуры

Процедура ТестДокументИКодеки() Экспорт
    Временный = Каталог(); Путь = CombinePath(Временный,"out.txt");
    Т = Новый TextDocument;
    Проверка.Равно(Т.LineCount(),0);
    Т.SetText("A"+Символы.ВК+Символы.ПС+"B"+Символы.ПС);
    Т.AddLine("C"); Т.InsertLine(2,"X"); Т.ReplaceLine(1,"Y"); Т.DeleteLine(3);
    Проверка.Равно(Т.GetText(),"Y"+Символы.ПС+"X"+Символы.ПС+"C"+Символы.ПС);
    Т.Write(Путь); Проверка.Равно(Hex(Путь),"EFBBBF590D0A580D0A430D0A");
    Т.Clear(); Т.Read(Путь); Проверка.Равно(Т.GetLine(2),"X");
    Проверка.Равно(Base64Value("Q Q=="),Неопределено);
    Проверка.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(Base64Значение("AEH/")),"0041FF");
    Проверка.Равно(GetStringFromBinaryData(GetBinaryDataFromString("Привет","windows-1251"),TextEncoding.ANSI),"Привет");
    Проверка.Равно(GetHexStringFromBinaryData(GetBinaryDataFromHexString("41 42")),"4142");
    Для Каждого Неверное Из СтрРазделить("QQ,Q!Q==",",") Цикл
        Проверка.Равно(Base64Value(Неверное),Неопределено);
    КонецЦикла;
    GetBinaryDataFromHexString("41FF42").Write(Путь);
    Ч = Новый TextReader(Путь,TextEncoding.UTF8); Ошибка = Ложь;
    Попытка Результат = Ч.Read(); Исключение Ошибка = Истина; КонецПопытки;
    Ч.Close(); Проверка.Проверить(Ошибка, "повреждённый UTF8 не заменяется молча");
    Ошибка = Ложь;
    Попытка З = Новый TextWriter(Путь,"no-such-encoding"); Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    УдалитьФайлы(Временный);
КонецПроцедуры

Процедура ТестПотокиИБуферы() Экспорт
    ТипПотока = Тип("FileStream"); ТипКодировки = Тип("TextEncoding");
    Проверка.Равно(ТипЗнч(TextEncoding.UTF8),ТипКодировки);
    Временный = Каталог(); Путь = CombinePath(Временный,"out.bin");
    Б = Новый BinaryDataBuffer(4,ByteOrder.LittleEndian); Б[0]=65; Б.Set(1,66);
    Проверка.Равно(Б.Size,4); Проверка.Равно(Б.Get(1),66);
    С = Новый FileStream(Путь,FileOpenMode.Create,FileAccess.ReadAndWrite);
    Проверка.Равно(ТипЗнч(С),ТипПотока);
    Проверка.Проверить(С.CanRead И С.CanWrite И С.CanSeek);
    С.Write(Б,0,2); Проверка.Равно(С.CurrentPosition(),2);
    Проверка.Равно(С.Seek(0,StreamPosition.Begin),0);
    Проверка.Равно(С.Read(Б,2,2),2); Проверка.Равно(Б[2],65); Проверка.Равно(Б[3],66);
    Проверка.Равно(С.Read(Б,0,1),0); С.SetSize(1); С.Flush(); С.Close(); С.Close();
    Проверка.Равно(Hex(Путь),"41");
    П = Новый MemoryStream(16); П.Write(Б,0,2); П.Seek(4); П.Write(Б,0,1);
    Проверка.Равно(П.Size(),5);
    Д = П.CloseAndGetBinaryData(); Проверка.Равно(GetHexStringFromBinaryData(Д),"4142000041");
    Ошибка = Ложь;
    Попытка П.Read(Б,0,1); Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Б[0]=256; Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    С = Новый FileStream(Путь,FileOpenMode.Append,FileAccess.Write); Ошибка = Ложь;
    Попытка С.Seek(0); Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка); С.Write(Б,1,1); С.Close(); Проверка.Равно(Hex(Путь),"4142");
    С = Новый FileStream(CombinePath(Временный,"new.bin"),FileOpenMode.OpenOrCreate,FileAccess.Read); Проверка.Равно(С.Size(),0); С.Close();
    УдалитьФайлы(Временный);
КонецПроцедуры

Процедура ТестПоискКопированиеИУдаление() Экспорт
    Временный = Каталог();
    Для Каждого Имя Из СтрРазделить("plain,a.txt,.hidden,a.",",") Цикл
        GetBinaryDataFromString("A").Write(CombinePath(Временный,Имя));
    КонецЦикла;
    CreateDirectory(CombinePath(Временный,"sub.txt")); CreateDirectory(CombinePath(Временный,"dir"));
    Проверка.Равно(FindFiles(Временный,"*").Количество(),6);
    Проверка.Равно(FindFiles(Временный,"*.*").Количество(),6);
    Проверка.Равно(FindFiles(Временный,"*.txt").Количество(),2);
    Проверка.Равно(FindFiles(Временный,"?.*").Количество(),3);
    GetBinaryDataFromString("AB").Write(CombinePath(Временный,"dir","child.txt"));
    Проверка.Равно(FindFiles(Временный,"*.txt",Истина).Количество(),3);
    CopyFile(CombinePath(Временный,"plain"),CombinePath(Временный,"a.txt"));
    Проверка.Равно(Hex(CombinePath(Временный,"a.txt")),"41");
    MoveFile(CombinePath(Временный,"a.txt"),CombinePath(Временный,"moved.txt"));
    Проверка.Проверить(Не Новый Файл(CombinePath(Временный,"a.txt")).Exist());
    DeleteFiles(Временный,"*.txt");
    Проверка.Проверить(Не Новый Файл(CombinePath(Временный,"sub.txt")).Exist());
    Проверка.Проверить(Не Новый Файл(GetTempFileName("txt")).Exist());
    Проверка.Равно(FindFiles(CombinePath(Временный,"missing"),"*").Количество(),0);
    DeleteFiles(Временный);
КонецПроцедуры

Процедура ТестДвоичныеДанныеЗаписьВПоток() Экспорт
    Поток = Новый ПотокВПамяти;
    ПолучитьДвоичныеДанныеИзСтроки("ABC").Записать(Поток);
    Поток.Перейти(1);
    ПолучитьДвоичныеДанныеИзHexСтроки("00FF").Write(Поток);
    Проверка.Равно(Поток.ТекущаяПозиция(), 3);
    ПолучитьДвоичныеДанныеИзСтроки("").Записать(Поток);
    Проверка.Равно(Поток.Размер(), 3);
    Проверка.Равно(ПолучитьHexСтрокуИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные()), "4100FF");
КонецПроцедуры

