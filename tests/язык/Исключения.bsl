// Язык: исключения.

Перем Проверка;

Процедура ТестТекстИсключения() Экспорт
	Попытка
		ВызватьИсключение "Нет товара";
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Проверка.Проверить(СтрНайти(Текст, "Нет товара") > 0, Текст);
КонецПроцедуры

Процедура ТестИсключениеИзВызова() Экспорт
	Попытка
		Упасть();
		Дошли = Истина;
	Исключение
		Дошли = Ложь;
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Проверка.Равно(Дошли, Ложь, "после исключения код в Попытке не выполняется");
	Проверка.Проверить(СтрНайти(Текст, "изнутри") > 0, Текст);
КонецПроцедуры

Процедура ТестПовторныйВыброс() Экспорт
	Попытка
		Попытка
			ВызватьИсключение "первое";
		Исключение
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Проверка.Проверить(СтрНайти(Текст, "первое") > 0, Текст);
КонецПроцедуры

Процедура Упасть()
	ВызватьИсключение "изнутри";
КонецПроцедуры

Проверка = Новый Проверка;
