Перем Проверка;

Процедура ТестЧисловойФормат() Экспорт
    Проверка.Равно(Формат(1234.5, "ЧГ=0;ЧРД=.;ЧДЦ=2"), "1234.50");
    Проверка.Равно(Format(1234.5, "NG=0;NDS=.;NFD=2"), "1234.50");
    Проверка.Равно(Формат(-1.25, "ЧГ=0;ЧРД=.;ЧДЦ=1"), "-1.3");
    Проверка.Равно(Формат(123456789012, "ЧГ=3;ЧРГ=_;ЧДЦ=0"), "123456789_012");
    Проверка.Равно(Формат(123456789012, "ЧГ=3,0;ЧРГ=_;ЧДЦ=0"), "123_456_789_012");
    Проверка.Равно(Формат(123456789012, "ЧГ=3,2,0;ЧРГ=_;ЧДЦ=0"), "1_23_45_67_89_012");
    Проверка.Равно(Формат(1234.500, "ЧГ=0;ЧРД=."), "1234.5");
    Проверка.Равно(Формат(0, "ЧДЦ=2"), "");
    Проверка.Равно(Формат(1234.5, ""), "1" + Символ(160) + "234,5");
    Проверка.Равно(Формат(12345678901234567890123456789012345678.125, "ЧГ=0;ЧРД=.;ЧДЦ=2"), "12345678901234567890123456789012345678.13");
    Проверка.Равно(Строка(1234.5), "1234.5", "Формат не меняет глобальную локаль Строка");
КонецПроцедуры

Процедура ТестКавычкиФормата() Экспорт
    Проверка.Равно(Формат(1234.5, "ЧГ=3;ЧРГ=';';ЧРД='=';ЧДЦ=2"), "1;234=50");
    Проверка.Равно(Формат(1234.5, "ЧГ=3;ЧРГ='''';ЧРД=.;ЧДЦ=2"), "1'234.50");
    Проверка.Равно(Формат(Истина, "БИ='yes;ok';БЛ=no"), "yes;ok");
    Проверка.Равно(Формат(Истина, "БИ=""yes;ok"";БЛ=no"), "yes;ok");
    Проверка.Равно(Format(False, "BF=no;BT=yes"), "no");
    Проверка.Равно(Формат(Ложь, ""), "Нет");
    Проверка.Равно(Формат(1.25, "ЧДЦ=1;ЧДЦ=2;ЧГ=0;ЧРД=."), "1.25");
КонецПроцедуры

Процедура ТестФорматДаты() Экспорт
    Д = Дата(2024, 2, 29, 13, 4, 5);
    Проверка.Равно(Формат(Д, "ДФ='yyyy-MM-dd HH:mm:ss'"), "2024-02-29 13:04:05");
    Проверка.Равно(Format(Д, "DF='дд.ММ.гггг ЧЧ:мм:сс'"), "29.02.2024 13:04:05");
    Проверка.Равно(Формат(Д, "ДФ='дд.ММ.гггг ''в'' ЧЧ:мм:сс'"), "29.02.2024 в 13:04:05");
    Проверка.Равно(Формат(Д, "ДФ='dddd, d MMMM yyyy h:mm tt'"), "четверг, 29 февраля 2024 1:04 PM");
    Проверка.Равно(Формат(Д + 0.125, "ДФ='HH:mm:ss.fff'"), "13:04:05.125");
    Проверка.Равно(Формат(Д, "ДФ=yyyy-MM-dd HH:mm:ss"), "29.02.2024 13:04:05", "некавыченный параметр с пробелом игнорируется");
    Проверка.Равно(Формат(Дата(1,1,1), "ДФ=yyyy-MM-dd"), "");
    Проверка.Равно(Строка(Д), "29.02.2024 13:04:05");
    Проверка.Равно(Формат(Неопределено, ""), "");
КонецПроцедуры

Процедура ОжидатьОшибку(Значение, ФорматнаяСтрока)
    Ошибка = Ложь;
    Попытка Результат = Формат(Значение, ФорматнаяСтрока);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка, "ожидалась ошибка: " + ФорматнаяСтрока);
КонецПроцедуры

Процедура ТестОшибкиФормата() Экспорт
    ОжидатьОшибку(12, "ЧДЦ=-1");
    ОжидатьОшибку(12, "ЧДЦ=1001");
    ОжидатьОшибку(12, "ЧГ=3,2,1");
    ОжидатьОшибку(12, "ЧРГ='незакрыто");
    ОжидатьОшибку(Дата(2024,2,29), "ДФ=yyyy-QQ-dd");
    ОжидатьОшибку(Дата(2024,2,29), "ДФ='yyyy ''текст'");
КонецПроцедуры

Проверка = Новый Проверка;
