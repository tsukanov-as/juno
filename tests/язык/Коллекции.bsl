// Язык: Массив, Структура, Соответствие, ТаблицаЗначений.

Перем Проверка;

Процедура ТестМассив() Экспорт
	Массив = Новый Массив;
	Массив.Добавить(10);
	Массив.Добавить(30);
	Массив.Вставить(1, 20);
	Проверка.Равно(Массив.Количество(), 3);
	Проверка.Равно(Массив[1], 20);
	Проверка.Равно(Массив.ВГраница(), 2);
	Проверка.Равно(Массив.Найти(30), 2);
	Проверка.Равно(Массив.Найти(99), Неопределено);
	Массив.Удалить(0);
	Сумма = 0;
	Для Каждого Элемент Из Массив Цикл
		Сумма = Сумма + Элемент;
	КонецЦикла;
	Проверка.Равно(Сумма, 50);
КонецПроцедуры

Процедура ТестСтруктура() Экспорт
	Структура = Новый Структура("Имя, Возраст", "Анна", 30);
	Проверка.Равно(Структура.Имя, "Анна");
	Структура.Вставить("Город", "Тверь");
	Проверка.Равно(Структура.Количество(), 3);
	Значение = Неопределено;
	Проверка.Проверить(Структура.Свойство("Город", Значение));
	Проверка.Равно(Значение, "Тверь");
	Проверка.Проверить(Не Структура.Свойство("Улица"));
	Структура.Возраст = 31;
	Проверка.Равно(Структура["Возраст"], 31);
КонецПроцедуры

Процедура ТестСоответствие() Экспорт
	Цены = Новый Соответствие;
	Цены.Вставить("Хлеб", 45);
	Цены["Молоко"] = 90;
	Цены.Вставить(1, "число тоже ключ");
	Проверка.Равно(Цены["Хлеб"], 45);
	Проверка.Равно(Цены.Получить("Молоко"), 90);
	Проверка.Равно(Цены[1], "число тоже ключ");
	Проверка.Равно(Цены["Сыр"], Неопределено);
	Проверка.Равно(Цены.Количество(), 3);
	Ключи = Новый Массив;
	Для Каждого Пара Из Цены Цикл
		Ключи.Добавить(Строка(Пара.Ключ));
	КонецЦикла;
	Проверка.Равно(Ключи.Количество(), 3);
КонецПроцедуры

Процедура ТестТаблицаЗначений() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Товар");
	Таблица.Колонки.Добавить("Сумма");
	Строка = Таблица.Добавить();
	Строка.Товар = "Хлеб";
	Строка.Сумма = 45;
	Строка = Таблица.Добавить();
	Строка.Товар = "Молоко";
	Строка.Сумма = 90;
	Проверка.Равно(Таблица.Количество(), 2);
	Проверка.Равно(Таблица[1].Товар, "Молоко");
	Найдено = Таблица.НайтиСтроки(Новый Структура("Товар", "Молоко"));
	Проверка.Равно(Найдено.Количество(), 1);
	Проверка.Равно(Найдено[0].Сумма, 90);
	Итого = 0;
	Для Каждого Строка Из Таблица Цикл
		Итого = Итого + Строка.Сумма;
	КонецЦикла;
	Проверка.Равно(Итого, 135);
КонецПроцедуры

Процедура ПроверитьПару(Ключ, Значение)
	Проверка.Равно(Ключ, "Имя");
	Проверка.Равно(Значение, "Анна");
КонецПроцедуры

Процедура ТестИменаСвойствКлючИЗначение() Экспорт
	Коллекции = Новый Массив;
	Структура = Новый Структура("Имя", "Анна");
	Коллекции.Добавить(Структура);
	Коллекции.Добавить(Новый ФиксированнаяСтруктура(Структура));
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Имя", "Анна");
	Коллекции.Добавить(Соответствие);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Пара Из Коллекция Цикл
			Проверка.Равно(Пара.Key, Пара.Ключ);
			Проверка.Равно(Пара.vAlUe, Пара.Значение);
			ПроверитьПару(Пара.KEY, Пара.VALUE);
			Ошибка = Ложь;
			Попытка Пара.Value = "другое";
			Исключение Ошибка = Истина; КонецПопытки;
			Проверка.Проверить(Ошибка, "свойство пары доступно только для чтения");
			Проверка.Равно(Пара.Value, "Анна");
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Проверка = Новый Проверка;
