Перем Проверка;

Функция Прочесть(Текст, Соответствия = Ложь)
    Ч = Новый ЧтениеJSON; Ч.УстановитьСтроку(Текст);
    Возврат ПрочитатьJSON(Ч, Соответствия);
КонецФункции

Функция Записать(Значение)
    З = Новый ЗаписьJSON; З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
    ЗаписатьJSON(З, Значение); Возврат З.Закрыть();
КонецФункции

Процедура ТестJSONТипыТочностьИNull() Экспорт
    ТЧ = Тип("JSONReader"); ТЗ = Тип("JSONWriter"); ТТ = Тип("JSONValueType");
    Ч = Новый JSONReader; Проверка.Равно(ТипЗнч(Ч), ТЧ);
    Проверка.Равно(ТипЗнч(Новый JSONWriter), ТЗ);
    Проверка.Равно(ТипЗнч(JSONValueType.ObjectStart), ТТ);
    Проверка.Равно(ТипЗнч(Новый JSONWriterSettings), Тип("ПараметрыЗаписиJSON"));
    З = Прочесть("{""n"":12345678901234567890.12345678,""b"":true,""s"":""ё😀"",""nil"":null}");
    Проверка.Равно(З.n, 12345678901234567890.12345678);
    Проверка.Проверить(З.b);
    Проверка.Равно(З.s, "ё😀"); Проверка.Равно(ТипЗнч(З.nil), Тип("Null"));
    Проверка.Проверить(З.nil <> Неопределено);
    Проверка.Равно(Записать(Неопределено), "null"); Проверка.Равно(Записать(Null), "null");
    Проверка.Равно(Прочесть(Записать(З)).n, З.n);
    Проверка.Равно(Прочесть("{""a"":1,""a"":2}").a, 2);
    Проверка.Равно(Прочесть("{""a-b"":1}", Истина).Получить("a-b"), 1);
КонецПроцедуры

Процедура ТестJSONКурсорИSkip() Экспорт
    Ч = Новый JSONReader; Ч.SetString("/*x*/[[1],2]");
    Проверка.Равно(Ч.CurrentValueType, JSONValueType.None);
    Проверка.Равно(Ч.CurrentLine, 0); Проверка.Равно(Ч.CurrentPosition, 0);
    Проверка.Проверить(Ч.Read()); Проверка.Равно(Ч.CurrentValueType, JSONValueType.Comment);
    Проверка.Равно(Ч.CurrentValue, "x");
    Ч.Read(); Ч.Read(); Проверка.Проверить(Ч.Skip());
    Проверка.Равно(Ч.CurrentValue, 2); Проверка.Равно(Ч.CurrentValueType, JSONValueType.Number);
    Ч.Read(); Проверка.Равно(Ч.CurrentValueType, JSONValueType.ArrayEnd);
    Проверка.Проверить(Не Ч.Read()); Проверка.Проверить(Не Ч.Read()); Ч.Close();
    Проверка.Равно(Ч.CurrentLine, Неопределено);
    Ч.SetString("[1,2]"); Ч.Read(); Проверка.Равно(ReadJSON(Ч),1); Ч.Close();
    Ч.SetString("{""a"":[1]}"); Ч.Read(); Ч.Read();
    Проверка.Равно(ReadJSON(Ч).Get(0), 1); Проверка.Равно(Ч.CurrentValueType, JSONValueType.ArrayEnd);
    Ч.Close();
КонецПроцедуры

Процедура ТестJSONWriterСостояние() Экспорт
    З = Новый JSONWriter; З.SetString(Новый JSONWriterSettings(JSONLineBreak.None));
    З.WriteStartObject(); З.WritePropertyName("a"); З.WriteStartArray(); З.WriteValue(1); З.WriteValue(Null);
    З.WriteEndArray(); З.WritePropertyName("raw"); З.WriteRaw("[true]"); З.WriteEndObject();
    Проверка.Равно(З.Close(), "{""a"":[1,null],""raw"":[true]}"); Проверка.Равно(З.Close(), "");
КонецПроцедуры

Процедура ТестJSONЯвныеДаты() Экспорт
    Д = Дата(2024,2,29,13,4,5);
    С = WriteJSONDate(Д, JSONDateFormat.ISO, JSONDateWritingVariant.LocalDate);
    Проверка.Равно(С,"2024-02-29T13:04:05");
    Проверка.Равно(ReadJSONDate(С, JSONDateFormat.ISO), Д);
    Проверка.Равно(Записать(WriteJSONDate(Д,JSONDateFormat.ISO)), """2024-02-29T13:04:05""");
    Проверка.Равно(Записать(Д), """2024-02-29T13:04:05""");
    Проверка.Равно(Записать(Дата(1,1,1)), """0001-01-01T00:00:00""");
    Структура = Новый Структура("а,б", Д, 1);
    Проверка.Равно(Записать(Структура), "{""а"":""2024-02-29T13:04:05"",""б"":1}");
    Проверка.Равно(ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO), "2024-02-29T13:04:05");
    Проверка.Равно(ПрочитатьДатуJSON("20240229T130405", ФорматДатыJSON.ISO), Д);
    Проверка.Равно(ПрочитатьДатуJSON("2024-02-29T13:04:05.987", ФорматДатыJSON.ISO), Д);
    Попытка ЗаписатьДатуJSON(Д, ФорматДатыJSON.JavaScript); Ошибка = Ложь; Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка, "локальную дату нельзя записать в формате JavaScript");
    Настройки = Новый НастройкиСериализацииJSON;
    Проверка.Равно(Настройки.ФорматСериализацииДаты, ФорматДатыJSON.ISO);
    Проверка.Равно(Настройки.ВариантЗаписиДаты, ВариантЗаписиДатыJSON.ЛокальнаяДата);
    Ч = Новый JSONReader; Ч.SetString("{""d"":""2024-02-29T13:04:05""}");
    Имена = Новый Array; Имена.Add("d");
    Проверка.Равно(ReadJSON(Ч,Ложь,Имена,JSONDateFormat.ISO).d, Д); Ч.Close();
КонецПроцедуры

Процедура ТестФиксированныеКоллекцииДляJSON() Экспорт
    ТА = Тип("FixedArray"); ТС = Тип("FixedMap");
    Вложенный = Новый Массив; Вложенный.Добавить(1);
    А = Новый Массив; А.Добавить(Вложенный); ФА = Новый FixedArray(А); А.Очистить();
    Проверка.Равно(ТипЗнч(ФА), ТА); Проверка.Равно(Строка(ФА),"ФиксированныйМассив");
    Вложенный.Установить(0, 2); Проверка.Равно(ФА.Получить(0).Get(0), 2);
    М = Новый Map; М.Insert("a",ФА); ФМ = Новый FixedMap(М); М.Clear();
    Проверка.Равно(ТипЗнч(ФМ), ТС); Проверка.Равно(Строка(ФМ),"ФиксированноеСоответствие");
    Проверка.Равно(Записать(ФМ),"{""a"":[[2]]}");
    Проверка.Равно(Новый Map(ФМ).Get("a"),ФА);
    Копия = Новый Array(ФА); Копия.Set(0,0); Проверка.Равно(ФА.Get(0),Вложенный);
    Проверка.Равно(ФА.Find(Вложенный),0);
    ФС = Новый FixedStructure(Новый Structure("v",ФМ));
    Проверка.Равно(Записать(ФС),"{""v"":{""a"":[[2]]}}");
КонецПроцедуры

Процедура ТестЗапретИзмененияФиксированныхКоллекций() Экспорт
    А = Новый Array; А.Add(1); Ф = Новый FixedArray(А);
    Ошибок = 0;
    Попытка Ф[0]=2; Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка Ф.Set(0,2); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка Ф.Add(2); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка Ф.Clear(); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Проверка.Равно(Ошибок,4); Проверка.Равно(Ф.Get(0),1);
    М=Новый Map; М.Insert("a",1); ФМ=Новый FixedMap(М); Ошибок=0;
    Попытка ФМ["a"]=2; Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка ФМ.Insert("a",2); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка ФМ.Delete("a"); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Проверка.Равно(Ошибок,3); Проверка.Равно(ФМ.Get("a"),1);
КонецПроцедуры

