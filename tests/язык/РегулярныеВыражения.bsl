Перем А;

Процедура ПроверитьРезультат(Результат, Начало, Длина, Значение)
    А.Равно(Результат.НачальнаяПозиция, Начало);
    А.Равно(Результат.Length, Длина);
    А.Равно(Результат.Значение, Значение);
КонецПроцедуры

Процедура ТестПоискИГруппы() Экспорт
    Результат = СтрНайтиПоРегулярномуВыражению("x😀ЁЖ42", "(ЁЖ)([0-9]+)");
    ПроверитьРезультат(Результат, 4, 4, "ЁЖ42");
    А.Равно(ТипЗнч(Результат), Тип("ResultOfSearchByRegularExpression"));
    Группы = Результат.ПолучитьГруппы();
    А.Равно(Группы.Количество(), 2);
    ПроверитьРезультат(Группы[0], 4, 2, "ЁЖ");
    ПроверитьРезультат(Группы[1], 6, 2, "42");
    А.Равно(ТипЗнч(Группы[0]), Тип("ГруппаРезультатаПоискаПоРегулярномуВыражению"));
    ПроверитьРезультат(СтрНайтиПоРегулярномуВыражению("abc", "Z"), 0, 0, "");
КонецПроцедуры

Процедура ТестРегистрИПолнаяСтрока() Экспорт
    А.Истина(СтрПодобнаПоРегулярномуВыражению("ёж42", "ЁЖ\d+", Истина));
    А.Ложь(СтрПодобнаПоРегулярномуВыражению("ёж42", "ЁЖ\d+"));
    А.Ложь(StrLikeByRegularExpression("x42y", "[0-9]+"));
    А.Истина(STRLIKEBYREGULAREXPRESSION("42", "[0-9]+"));
    А.Истина(стрподобнапорегулярномувыражению("Ж９", "\w\d"));
КонецПроцедуры

Процедура ТестВсеСовпаденияИМногострочность() Экспорт
    Текст = "one" + Символы.ПС + "two" + Символы.ПС + "three";
    Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, "^two$", Ложь, Истина);
    А.Равно(Совпадения.Количество(), 1);
    ПроверитьРезультат(Совпадения[0], 5, 3, "two");
    А.Равно(StrFindAllByRegularExpression(Текст, "^two$").Count(), 0);
    А.Ложь(StrLikeByRegularExpression("a" + Символы.ПС + "b", "a.b"));
    А.Истина(StrLikeByRegularExpression("a" + Символы.ПС + "b", "(?s)a.b"));
КонецПроцедуры

Процедура ТестЗаменаСГруппами() Экспорт
    Текст = "2024-02-29;2025-01-01";
    А.Равно(СтрЗаменитьПоРегулярномуВыражению(Текст, "(\d{4})-(\d{2})-(\d{2})", "$3.$2.$1"),
        "29.02.2024;01.01.2025");
    А.Равно(StrReplaceByRegularExpression("a A", "a", "[$0]", Истина), "[a] [A]");
    А.Равно(StrReplaceByRegularExpression("none", "[0-9]+", "x"), "none");
КонецПроцедуры

Процедура ТестРезультатыТолькоЧтение() Экспорт
    Результат = StrFindByRegularExpression("ab", "(a)b");
    Ошибок = 0;
    Попытка Результат.Value = "x"; Исключение Ошибок = Ошибок + 1; КонецПопытки;
    Группа = Результат.GetGroups()[0];
    Попытка Группа.StartIndex = 99; Исключение Ошибок = Ошибок + 1; КонецПопытки;
    Попытка Группа.GetGroups(); Исключение Ошибок = Ошибок + 1; КонецПопытки;
    А.Равно(Ошибок, 3);
    Группы = Результат.GetGroups(); Группы.Очистить();
    А.Равно(Результат.GetGroups().Count(), 1);
    ПроверитьРезультат(Результат, 1, 2, "ab");
КонецПроцедуры

Процедура ТестПустыеСовпадения() Экспорт
    А.Равно(StrFindAllByRegularExpression("abc", "").Count(), 0);
    А.Истина(StrLikeByRegularExpression("", ""));
    ПроверитьРезультат(StrFindByRegularExpression("", ""), 0, 0, "");
    Совпадения = StrFindAllByRegularExpression("😀", "(?=)");
    А.Равно(Совпадения.Count(), 2);
    ПроверитьРезультат(Совпадения[0], 1, 0, "");
    ПроверитьРезультат(Совпадения[1], 3, 0, "");
    Совпадения = StrFindAllByRegularExpression("a", "a*");
    ПроверитьРезультат(Совпадения[1], 2, 0, "");
    А.Равно(StrReplaceByRegularExpression("a", "a*", "X"), "XX");
КонецПроцедуры

Процедура ТестНаправлениеПозицияИВхождение() Экспорт
    ПроверитьРезультат(StrFindByRegularExpression("ababa", "aba", SearchDirection.FromEnd), 3, 3, "aba");
    ПроверитьРезультат(StrFindByRegularExpression("abc", "bc", НаправлениеПоиска.СКонца, 2), 2, 2, "bc");
    ПроверитьРезультат(StrFindByRegularExpression("a1a2a3", "a.", SearchDirection.FromEnd, , 2), 3, 2, "a2");
    ПроверитьРезультат(StrFindByRegularExpression("ababa", "aba", , , 2), 0, 0, "");
    ПроверитьРезультат(StrFindByRegularExpression("abc", "(?<=a)b", , 2), 2, 1, "b");
    ПроверитьРезультат(StrFindByRegularExpression("abc", "b", , 1.9), 2, 1, "b");
    Группы = StrFindByRegularExpression("b", "(a)?(b)").GetGroups();
    ПроверитьРезультат(Группы[0], 0, 0, "");
    Группы = StrFindByRegularExpression("b", "()(b)").GetGroups();
    ПроверитьРезультат(Группы[0], 1, 0, "");
    А.Равно(StrReplaceByRegularExpression("a", "(a)", "$12"), "a2");
    А.Равно(StrReplaceByRegularExpression("a", "a", "$$"), "$$");
    А.Равно(StrReplaceByRegularExpression("a", "(a)", "${1}"), "${1}");
КонецПроцедуры

Процедура ТестНеверныйШаблонИАргументы() Экспорт
    Ошибок = 0;
    Попытка СтрПодобнаПоРегулярномуВыражению("a", "[");
    Исключение
        Ошибок = Ошибок + 1;
        А.Содержит(ОписаниеОшибки(), "позиция");
        А.Содержит(ИнформацияОбОшибке().ИсходнаяСтрока, "СтрПодобнаПоРегулярномуВыражению");
    КонецПопытки;
    Попытка StrFindByRegularExpression("abc", "b", , 0); Исключение Ошибок = Ошибок + 1; КонецПопытки;
    Попытка StrLikeByRegularExpression("abc", ".*", "true"); Исключение Ошибок = Ошибок + 1; КонецПопытки;
    Попытка StrFindByRegularExpression("abc", "b", 1); Исключение Ошибок = Ошибок + 1; КонецПопытки;
    А.Равно(Ошибок, 4);
КонецПроцедуры

А = Новый Утверждения;
