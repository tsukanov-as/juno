Процедура ТестДеревоВладельцыИПоиск() Экспорт
    Д = Новый ДеревоЗначений; Д.Колонки.Добавить("Код"); Д.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
    Корень = Д.Строки.Добавить(); Корень.Код = "root"; Корень.Сумма = 1;
    Дочь = Корень.Строки.Добавить(); Дочь.Код = "child"; Дочь.Сумма = 2;
    Внучка = Дочь.Строки.Добавить(); Внучка.Код = "grandchild"; Внучка.Сумма = 3;
    А.Истина(Корень.Родитель = Неопределено); А.Истина(Дочь.Parent = Корень);
    А.Истина(Дочь.Rows.Parent = Дочь); А.Истина(Внучка.Owner() = Д); А.Равно(Внучка.Level(), 2);
    А.Истина(Д.Rows.Find("child", "Код") = Неопределено);
    А.Истина(Д.Строки.Найти("child", "Код", Истина) = Дочь);
    А.Равно(Д.Строки.НайтиСтроки(Новый Структура("Код", "grandchild"), Истина).Количество(), 1);
    А.Равно(Д.Строки.Итог("Сумма"), 1); А.Равно(Д.Строки.Итог("Сумма", Истина), 6);
    Значения = Новый Массив; Для Каждого Значение Из Дочь Цикл Значения.Добавить(Значение); КонецЦикла;
    А.Равно(Значения[0], "child"); А.Равно(Значения[1], 2);
КонецПроцедуры

Процедура ТестДеревоКопированиеСортировкаЗагрузка() Экспорт
    Д = Новый ValueTree; Д.Columns.Add("Code"); Д.Columns.Add("Amount", Новый TypeDescription("Number"));
