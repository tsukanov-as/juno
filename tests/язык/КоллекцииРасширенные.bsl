    Т.Колонки.Добавить("Код"); Т.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
    С = Т.Добавить(); С.Код = "a"; С.Сумма = 1;
    С = Т.Добавить(); С.Код = "a"; С.Сумма = 2;
    С = Т.Добавить(); С.Код = "b"; С.Сумма = 3;
    Возврат Т;
КонецФункции

