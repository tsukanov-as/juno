Перем Проверка;

// Допустимые количества аргументов сняты с 1С 8.3.27.1606 вызовом каждой функции
// с 0..8 аргументами: остальные количества там не компилируются.

Процедура ТестДопустимыеКоличестваАргументов() Экспорт
    Проверка.Равно(Сред("abc", 2), "bc");
    Проверка.Равно(Сред("abc", 2, 1), "b");
    Проверка.Равно(СтрНайти("abcb", "b"), 2);
    Проверка.Равно(СтрНайти("abcb", "b", НаправлениеПоиска.СНачала, 3), 4);
    Проверка.Равно(СтрРазделить("a,b", ",").Количество(), 2);
    Проверка.Равно(СтрРазделить("a,,b", ",", Ложь).Количество(), 2);
    Проверка.Равно(СтрСоединить(СтрРазделить("a,b", ",")), "ab");
    Проверка.Равно(СтрСоединить(СтрРазделить("a,b", ","), "-"), "a-b");
    Проверка.Равно(СтрШаблон("%1", "x"), "x");
    Проверка.Равно(СтрШаблон("%1%2", "x", "y"), "xy");
    Проверка.Равно(Мин(3, 1, 2), 1);
    Проверка.Равно(Макс(1, 2, 3, 4, 5, 6, 7, 8, 9), 9);
    Проверка.Равно(Окр(2.5), 3);
    Проверка.Равно(Окр(1.25, 1), 1.3);
    Проверка.Равно(Окр(2.5, 0, 0), 2);
    Проверка.Равно(КодСимвола("ab"), 97);
    Проверка.Равно(КодСимвола("ab", 2), 98);
    Проверка.Равно(Дата(2024, 2, 29), Дата(2024, 2, 29, 0, 0, 0));
    Проверка.Равно(Год(Дата("20240229")), 2024);
КонецПроцедуры

Проверка = Новый Проверка;
