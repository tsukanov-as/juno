// Язык: модуль — это класс. Новый создаёт объект и выполняет тело модуля.

Перем Проверка;

Процедура ТестОбъект() Экспорт
	Счетчик = Новый язык.Счетчик;
	Проверка.Равно(Счетчик.Значение, 0, "тело модуля выполнилось при Новый");
	Счетчик.Увеличить();
	Счетчик.Увеличить();
	Проверка.Равно(Счетчик.Значение, 2);
	Счетчик.Значение = 10;
	Проверка.Равно(Счетчик.Значение, 10, "экспортное поле можно менять снаружи");
КонецПроцедуры

Процедура ТестОбъектыНезависимы() Экспорт
	Первый = Новый язык.Счетчик;
	Второй = Новый язык.Счетчик;
	Первый.Увеличить();
	Проверка.Равно(Первый.Значение, 1);
	Проверка.Равно(Второй.Значение, 0);
КонецПроцедуры

Процедура ТестЗакрытоеПоле() Экспорт
	Счетчик = Новый язык.Счетчик;
	Закрыто = Ложь;
	Попытка
		Шаг = Счетчик.Шаг;
	Исключение
		Закрыто = Истина;
	КонецПопытки;
	Проверка.Проверить(Закрыто, "поле без Экспорт недоступно снаружи");
КонецПроцедуры

Процедура ТестПараметры() Экспорт
	Счетчик = Новый язык.Счетчик;
	Шаг = 5;
	Счетчик.УстановитьШаг(Шаг);
	Проверка.Равно(Шаг, 5, "Знач");
	Счетчик.Увеличить();
	Проверка.Равно(Счетчик.Значение, 5);
	Число = 7;
	Счетчик.Обнулить(Число);
	Проверка.Равно(Число, 0, "по ссылке");
	Проверка.Равно(Счетчик.Удвоить(21), 42, "значение по умолчанию");
	Проверка.Равно(Счетчик.Удвоить(2, 10), 20);
КонецПроцедуры

Процедура ТестПараметрыКонструктора() Экспорт
	Счетчик = Новый язык.Счетчик(10, 5);
	Проверка.Равно(Счетчик.Значение, 10);
	Счетчик.Увеличить();
	Проверка.Равно(Счетчик.Значение, 15);
	Счетчик = Новый язык.Счетчик(7);
	Проверка.Равно(Счетчик.Значение, 7, "второй параметр по умолчанию");
КонецПроцедуры

Процедура ТестОшибкиКонструктора() Экспорт
	Проверка.Проверить(Ошибка("Новый язык.Счетчик(1, 2, 3)", "Слишком много параметров"));
	Проверка.Проверить(Ошибка("Новый язык.Узел", "Не хватает параметров"));
	Проверка.Проверить(Ошибка("Новый Проверка(1)", "не принимает параметры"));
КонецПроцедуры

Процедура ТестРекурсивноеСоздание() Экспорт
	// Узел с глубиной 3 создаёт два узла с глубиной 2 и так далее: 1 + 2 + 4 + 8 узлов.
	Корень = Новый язык.Узел(3);
	Проверка.Равно(Корень.Количество(), 15);
КонецПроцедуры

Функция Ошибка(Что, Фрагмент)
	Попытка
		Если Что = "Новый язык.Счетчик(1, 2, 3)" Тогда
			Объект = Новый язык.Счетчик(1, 2, 3);
		ИначеЕсли Что = "Новый язык.Узел" Тогда
			Объект = Новый язык.Узел;
		Иначе
			Объект = Новый Проверка(1);
		КонецЕсли;
	Исключение
		Возврат СтрНайти(ОписаниеОшибки(), Фрагмент) > 0;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Процедура ТестТипКласса() Экспорт
	Счетчик = Новый язык.Счетчик;
	Проверка.Равно(Строка(ТипЗнч(Счетчик)), "язык.Счетчик", "тип называется полным именем класса");
	Проверка.Проверить(ТипЗнч(Счетчик) = Тип("язык.Счетчик"));
	Проверка.Проверить(ТипЗнч(Счетчик) = Тип("ЯЗЫК.СЧЕТЧИК"), "регистр не важен");
	Проверка.Проверить(ТипЗнч(Счетчик) <> Тип("Счетчик"), "без пространства имён — другой класс");
	Проверка.Проверить(ТипЗнч(Счетчик) <> ТипЗнч(Новый язык.Узел(0)));
КонецПроцедуры

Процедура ТестАргументыКоманднойСтроки() Экспорт
	// В тестах аргументов нет; массив каждый раз новый, менять его безопасно.
	Аргументы = АргументыКоманднойСтроки;
	Проверка.Равно(Аргументы.Количество(), 0);
	Аргументы.Добавить("лишний");
	Проверка.Равно(АргументыКоманднойСтроки.Количество(), 0);
КонецПроцедуры

Процедура ТестФоновоеЗадание() Экспорт
	Параметры = Новый Массив;
	Параметры.Добавить(21);
	Задание = ФоновыеЗадания.Выполнить("язык.Счетчик.Удвоить", Параметры);
	Задание.ОжидатьЗавершенияВыполнения();
	Проверка.Равно(Задание.ПолучитьРезультат(), 42);
КонецПроцедуры

Проверка = Новый Проверка;
