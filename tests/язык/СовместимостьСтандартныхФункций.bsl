Процедура ТестДокументИПоврежденныеДанные() Экспорт
    Д=Новый ТекстовыйДокумент;
    Д.УстановитьТекст("a"+Символ(10)+"b");
    Проверка.Равно(Д.ПолучитьТекст(),"a"+Символ(10)+"b");
    Д.УстановитьТекст("a"+Символ(10));
    Проверка.Равно(Д.КоличествоСтрок(),1);
    Проверка.Равно(Д.ПолучитьТекст(),"a"+Символ(10));
    Д.ДобавитьСтроку("b");
    Проверка.Равно(Д.ПолучитьТекст(),"a"+Символ(10)+"b"+Символ(10));
    Проверка.Равно(Base64Строка(Base64Значение("@@@")),"");
    Проверка.Равно(Base64Значение("Y!Q=="),Неопределено);
    Проверка.Равно(Base64Строка(Base64Значение("YWJj!!")),"YWJj");
    Проверка.Равно(ПолучитьСтрокуИзДвоичныхДанных(Base64Значение("/w=="),КодировкаТекста.UTF8),Символ(65533));
КонецПроцедуры

