Процедура ТестСтрокиПоКонтрактуПлатформы() Экспорт
    Проверка.Равно(СтрЗаменить("abc","","x"),"abc");
    Проверка.Равно(ВРег("straße ﬁ"),"STRAßE ﬁ");
    Проверка.Равно(НРег("İ I ΟΣ ẞ"),"i i οσ ß");
    Проверка.Равно(Символ(128512),"");
    Проверка.Равно(КодСимвола(""),-1);
    Проверка.Равно(КодСимвола("a",0),-1);
    Проверка.Равно(СтрШаблон("a%2b",1),"ab");
    Проверка.Равно(СтрШаблон("%% %1 %10",1),"% 1 ");
