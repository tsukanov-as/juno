    Проверка.Равно(XMLСтрока(2/3*3),"2.000000000000000000000000001");
    Проверка.Равно(XMLСтрока(1/3000000000000000000000000000),"0.000000000000000000000000000333333333333333333333333333");
    Проверка.Равно(XMLСтрока(10.00),"10");
    М=Новый Массив; М.Добавить(10); М.Добавить(20);
    Проверка.Равно(М[1.5],20);
КонецПроцедуры

