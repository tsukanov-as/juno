// Вспомогательный модуль: узел дерева, которое строится рекурсивно через Новый с параметром.

Перем Левый, Правый;

Процедура ПриСозданииОбъекта(Глубина)
	Если Глубина > 0 Тогда
		Левый = Новый язык.Узел(Глубина - 1);
		Правый = Новый язык.Узел(Глубина - 1);
	КонецЕсли;
КонецПроцедуры

Функция Количество() Экспорт
	Если Левый = Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 1 + Левый.Количество() + Правый.Количество();
КонецФункции
