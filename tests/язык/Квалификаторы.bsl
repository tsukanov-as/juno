Перем Проверка;

Процедура ТестКвалификаторыЧисла() Экспорт
    О=Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(4,2));
    Проверка.Равно(О.ПривестиЗначение(12.345),12.35);
    Проверка.Равно(О.ПривестиЗначение(-1.555),-1.56);
    Проверка.Равно(О.ПривестиЗначение(99999),99.99);
    Проверка.Равно(О.ПривестиЗначение("12.345"),12.35);
    Проверка.Равно(О.КвалификаторыЧисла.Разрядность,4);
    О=Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(4,2,ДопустимыйЗнак.Неотрицательный));
    Проверка.Равно(О.ПривестиЗначение(-12.3),0);
    О=Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла);
    Проверка.Равно(О.ПривестиЗначение(12.345),12.345);
КонецПроцедуры

Процедура ТестКвалификаторыСтрокиИДаты() Экспорт
    О=Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(4,ДопустимаяДлина.Фиксированная));
    Проверка.Равно(О.ПривестиЗначение("abcdef"),"abcd");
    Проверка.Равно(О.ПривестиЗначение("ab"),"ab  ");
    Проверка.Равно(О.ПривестиЗначение(),"    ");
    Д=Дата(2026,1,5,7,8,9);
    О=Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.Дата));
    Проверка.Равно(О.ПривестиЗначение(Д),Дата(2026,1,5));
    О=Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.Время));
    Проверка.Равно(О.ПривестиЗначение(Д),Дата(1,1,1,7,8,9));
КонецПроцедуры

Процедура ТестКвалификаторыВКолонках() Экспорт
    Т=Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Сумма",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(4,2)));
    Т.Колонки.Добавить("Код",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(4,ДопустимаяДлина.Фиксированная)));
    Р=Т.Добавить();
    Проверка.Равно(Р.Код,"    ");
    Р.Сумма=1234;Р.Код="abcde";
    Проверка.Равно(Р.Сумма,99.99);Проверка.Равно(Р.Код,"abcd");
    Р.Сумма=1.555;Проверка.Равно(Р.Сумма,1.56);
КонецПроцедуры

