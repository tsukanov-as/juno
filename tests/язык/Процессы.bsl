Перем Проверка;

Процедура ТестПроцессЗапускПотокиИКод() Экспорт
    ТП = Тип("Process");
    А = Новый Массив;
    Если ПолучитьПеременнуюСреды("OS") = "Windows_NT" Тогда
        А.Добавить(ПолучитьПеременнуюСреды("COMSPEC")); А.Добавить("/d"); А.Добавить("/c");
        А.Добавить("echo out&echo err 1>&2&exit /b 0");
    Иначе
        А.Добавить("/bin/sh"); А.Добавить("-c"); А.Добавить("printf out; printf err >&2");
    КонецЕсли;
    П = СоздатьПроцессСАргументами(А, "", Истина);
    Проверка.Равно(ТипЗнч(П), ТП);
    Проверка.Равно(П.КодировкаВывода, Неопределено);
    Проверка.Равно(П.ПотокВывода, Неопределено);
    П.Запустить();
    Проверка.Проверить(П.ОжидатьЗавершения(10000));
    Проверка.Проверить(П.Завершен); Проверка.Равно(П.КодВозврата,0);
    Проверка.Равно(СокрЛП(П.ПотокВывода.Прочитать()),"out");
    Проверка.Равно(П.ПотокВывода.Прочитать(),Неопределено);
    Проверка.Равно(СокрЛП(П.ПотокОшибок.Прочитать()),"err");
    Проверка.Равно(П.ПотокОшибок.Прочитать(),Неопределено);
    П.Закрыть(); П.Закрыть();
КонецПроцедуры

Процедура ТестПроцессСтроковыйКонтрактИОшибки() Экспорт
    Если ПолучитьПеременнуюСреды("OS") = "Windows_NT" Тогда
        Команда = """" + ПолучитьПеременнуюСреды("COMSPEC") + """ /d /c exit 0";
    Иначе Команда = "/bin/sh -c 'exit 0'"; КонецЕсли;
    П = CreateProcess(Команда, "", Истина);
    П.Start(); Проверка.Проверить(П.WaitForExit());
    Проверка.Равно(П.ExitCode,0); Проверка.Проверить(П.ProcessId>0);
    П.Close();
    Ошибок=0;
    Попытка П.Start(); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка П=Новый Процесс; Исключение Ошибок=Ошибок+1; КонецПопытки;
    Попытка П=CreateProcess("java ""unterminated"); Исключение Ошибок=Ошибок+1; КонецПопытки;
    А=Новый Массив; А.Добавить("");
    Попытка П=CreateProcessWithArguments(А); Исключение Ошибок=Ошибок+1; КонецПопытки;
    Проверка.Равно(Ошибок,4);
КонецПроцедуры

Проверка=Новый Проверка;
