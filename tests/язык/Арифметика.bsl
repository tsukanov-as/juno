// Язык: числа — точная десятичная арифметика, как в 1С.

Перем Проверка;

Процедура ТестТочность() Экспорт
	Проверка.Равно(0.1 + 0.2, 0.3);
	Проверка.Равно(10 / 4, 2.5);
	Проверка.Равно(1000000000000000000000 + 1, 1000000000000000000001);
КонецПроцедуры

Процедура ТестЦелОкрОстаток() Экспорт
	Проверка.Равно(Цел(7.9), 7);
	Проверка.Равно(Цел(-7.9), -7);
	Проверка.Равно(Окр(2.345, 2), 2.35);
	Проверка.Равно(Окр(2.5), 3);
	Проверка.Равно(7 % 3, 1);
	Проверка.Равно(-7 % 3, -1, "остаток со знаком делимого");
КонецПроцедуры

Процедура ТестРежимОкругления() Экспорт
	Проверка.Равно(Окр(1.5, 0, 0), 1);
	Проверка.Равно(Окр(-1.5, 0, 0), -1);
	Проверка.Равно(Окр(2.5, 0, 0), 2);
	Проверка.Равно(Окр(-2.5, 0, 0), -2);
	Проверка.Равно(Окр(1.51, 0, 0), 2);
	Проверка.Равно(Окр(-1.51, 0, 0), -2);
	Проверка.Равно(Окр(1.49, 0, 0), 1);
	Проверка.Равно(Окр(1.25, 1, 0), 1.2);
	Проверка.Равно(Окр(-1.25, 1, 0), -1.2);
	Проверка.Равно(Окр(150, -2, 0), 100);
	Проверка.Равно(Окр(-150, -2, 1), -200);
	Проверка.Равно(Окр(1.5, 0, 1), 2);
	Проверка.Равно(Round(-1.5, 0, 1), -2);
	Проверка.Равно(Round(1.5, 0, 2), 2);
	Проверка.Равно(Окр(-1.5), -2);
КонецПроцедуры

Процедура ТестДелениеНаНоль() Экспорт
	Текст = "";
	Попытка
		Результат = 1 / 0;
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Проверка.Проверить(Текст <> "", "деление на ноль — исключение");
КонецПроцедуры

Процедура ТестСравнения() Экспорт
	Проверка.Проверить(2 > 1);
	Проверка.Проверить(1.0 = 1, "1.0 и 1 — одно число");
	Проверка.Проверить("а" < "б");
	Проверка.Проверить(Не (1 = 2));
КонецПроцедуры

Проверка = Новый Проверка;
