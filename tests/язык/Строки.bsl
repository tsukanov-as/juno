// Язык: строки и строковые функции.

Перем Проверка;

Процедура ТестСоединение() Экспорт
	Проверка.Равно("а" + "б", "аб");
	Проверка.Равно("№" + 1, "№1");
	Проверка.Равно(СтрШаблон("%1 + %2", "один", "два"), "один + два");
	Проверка.Равно(СтрСоединить(СтрРазделить("а,б,в", ","), "-"), "а-б-в");
КонецПроцедуры

Процедура ТестЧасти() Экспорт
	Проверка.Равно(СтрДлина("привет"), 6);
	Проверка.Равно(Лев("привет", 2), "пр");
	Проверка.Равно(Прав("привет", 3), "вет");
	Проверка.Равно(Сред("привет", 3, 2), "ив");
	Проверка.Равно(Сред("привет", 4), "вет");
КонецПроцедуры

Процедура ТестПоискИЗамена() Экспорт
	Проверка.Равно(СтрНайти("привет", "ве"), 4);
	Проверка.Равно(СтрНайти("привет", "ы"), 0);
	Проверка.Равно(СтрЗаменить("а-б-в", "-", "+"), "а+б+в");
	Проверка.Проверить(СтрНачинаетсяС("привет", "при"));
КонецПроцедуры

Процедура ТестРегистрИПробелы() Экспорт
	Проверка.Равно(ВРег("Привет"), "ПРИВЕТ");
	Проверка.Равно(НРег("Привет"), "привет");
	Проверка.Равно(СокрЛП("  а  "), "а");
	Проверка.Проверить(ПустаяСтрока("   "));
КонецПроцедуры

Процедура ТестСимволы() Экспорт
	Проверка.Равно(КодСимвола("А"), 1040);
	Проверка.Равно(Символ(1040), "А");
	Проверка.Равно(СтрДлина("а" + Символы.ПС + "б"), 3);
КонецПроцедуры

Процедура ТестНеразрывныйПробел() Экспорт
	НП = Символ(160);
	Проверка.Равно(СокрЛП(НП + " а " + НП), "а");
	Проверка.Равно(TrimAll(НП + "а" + НП), "а");
	Проверка.Равно(СокрЛ(НП + "а" + НП), "а" + НП);
	Проверка.Равно(TrimR(НП + "а" + НП), НП + "а");
	Проверка.Равно(СокрЛП("а" + НП + "б"), "а" + НП + "б");
	Проверка.Проверить(ПустаяСтрока(НП + Символы.Таб + Символы.ПС));
	Проверка.Проверить(IsBlankString(НП));
	Для Каждого Код Из СтрРазделить("8203,65279", ",") Цикл
		Сим = Символ(Число(Код));
		Проверка.Равно(СокрЛП(Сим + "а" + Сим), Сим + "а" + Сим);
		Проверка.Проверить(Не ПустаяСтрока(Сим));
	КонецЦикла;
КонецПроцедуры

Процедура ТестНаправлениеПоиска() Экспорт
	Начало = НаправлениеПоиска.СНачала;
	Конец = SearchDirection.FromEnd;
	Проверка.Равно(Начало, SearchDirection.FromBegin);
	Проверка.Равно(Конец, НаправлениеПоиска.СКонца);
	Проверка.Равно(Строка(Конец), "СКонца");
	Проверка.Равно(ТипЗнч(Конец), Тип("НаправлениеПоиска"));
	Проверка.Равно(ТипЗнч(Начало), Тип("SearchDirection"));
	Проверка.Равно(Строка(ТипЗнч(Конец)), "НаправлениеПоиска");
	Проверка.Равно(Строка(НаправлениеПоиска), "ПеречислениеНаправлениеПоиска");
	Проверка.Равно(ТипЗнч(НаправлениеПоиска), Тип("ПеречислениеНаправлениеПоиска"));
	Проверка.Проверить(Начало <> Конец);
	Проверка.Проверить(Конец <> "СКонца");
	Счет = 0;
	Для Каждого Элемент Из SearchDirection Цикл
		Счет = Счет + 1;
		Проверка.Равно(ТипЗнч(Элемент), ТипЗнч(Начало));
	КонецЦикла;
	Проверка.Равно(Счет, 2);
	Ошибка = Ложь;
	Попытка НаправлениеПоиска.СНачала = Конец;
	Исключение Ошибка = Истина; КонецПопытки;
	Проверка.Проверить(Ошибка, "перечисление неизменяемо");
	Проверка.Равно(НаправлениеПоиска.СНачала, Начало);
КонецПроцедуры

Процедура ТестПоискСНаправлением() Экспорт
	Конец = НаправлениеПоиска.СКонца;
	Проверка.Равно(СтрНайти("abcabc", "bc", Конец), 5);
	Проверка.Равно(StrFind("abcabc", "bc", SearchDirection.FromEnd, 5), 2);
	Проверка.Равно(СтрНайти("abcabc", "bc", Конец, 3), 2);
	Проверка.Равно(СтрНайти("abcabc", "bc", Конец, 2), 0);
	Проверка.Равно(СтрНайти("abcabc", "bc", Конец, 0, 2), 2);
	Проверка.Равно(СтрНайти("abcabc", "bc", Конец, 0, 3), 0);
	Проверка.Равно(СтрНайти("aaaaa", "aa", , , 3), 3);
	Проверка.Равно(СтрНайти("aaaaa", "aa", Конец, , 2), 2);
	Проверка.Равно(СтрНайти("aaaaa", "aa", Конец, , 3), 0);
	Проверка.Равно(СтрНайти("abc", "a", , 0), 1);
	Проверка.Равно(СтрНайти("abc", "a", Неопределено, Неопределено, Неопределено), 1);
	Проверка.Равно(СтрНайти("abc", "", Конец, 2, 0), 1);
	Проверка.Равно(СтрНайти("", "", Конец), 1);
	Проверка.Равно(СтрНайти("", "a", Конец), 0);
	Проверка.Равно(СтрНайти("😀a😀a", "a", Конец), 6);
	Ошибка = Ложь;
	Попытка СтрНайти("abc", "a", "СКонца");
	Исключение Ошибка = Истина; КонецПопытки;
	Проверка.Проверить(Ошибка, "строка не заменяет значение перечисления");
	Ошибка = Ложь;
	Попытка СтрНайти("abc", "a", , 4);
	Исключение Ошибка = Истина; КонецПопытки;
	Проверка.Проверить(Ошибка, "начальная позиция за пределами строки");
КонецПроцедуры

Процедура ТестДополнительныеСтроковыеФункции() Экспорт
    Проверка.Равно(СтрСравнить("А", "а"), 0);
    Проверка.Равно(StrCompare("а", "б"), -1);
    Проверка.Равно(СтрСравнить("ё", "ж"), -1);
    Проверка.Проверить(СтрЗаканчиваетсяНа("abc", "bc"));
    Проверка.Проверить(Не StrEndsWith("abc", "BC"));
    Проверка.Равно(СтрЧислоСтрок(""), 1);
    Проверка.Равно(StrLineCount("а" + Символы.ПС), 2);
    Проверка.Равно(СтрЧислоСтрок("а" + Символы.ВК + "б"), 1);
    Проверка.Равно(StrGetLine("а" + Символы.ВК + Символы.ПС + "б", 1), "а" + Символы.ВК);
    Проверка.Равно(СтрПолучитьСтроку("а" + Символы.ПС, 2), "");
    Проверка.Равно(СтрПолучитьСтроку("а", 0), "");
    Проверка.Равно(СтрПолучитьСтроку("а", -1), "");
    Проверка.Равно(СтрПолучитьСтроку("а" + Символы.ПС + "б", 1.9), "а");
    Ошибка = Ложь;
    Попытка Результат = СтрПолучитьСтроку("а", 2);
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
    Ошибка = Ложь;
    Попытка Результат = СтрЗаканчиваетсяНа("а", "");
    Исключение Ошибка = Истина; КонецПопытки;
    Проверка.Проверить(Ошибка);
КонецПроцедуры

Процедура ТестСредГраницыИндекса() Экспорт
    Проверка.Равно(Сред("abc", 2, 2147483647), "bc");
    Проверка.Равно(Mid("abc", -2147483648), "abc");
    Проверка.Равно(Сред("abc", -2147483648, 2147483647), "abc");
    Проверка.Равно(Сред("abc", 2147483647, 2147483647), "");
    Проверка.Равно(Сред("abc", 2, -2147483648), "bc");
    Проверка.Равно(Сред("abc", 2, -1), "bc");
    Проверка.Равно(Сред("abc", 2, 0), "");
    Проверка.Равно(Сред("", 1, 2147483647), "");
КонецПроцедуры

Проверка = Новый Проверка;
