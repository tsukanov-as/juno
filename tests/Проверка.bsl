// Утверждения для тестов и помощники для тестов парсера.
// Тест падает, если выбрасывает исключение: каждое утверждение
// при несовпадении вызывает исключение с понятным текстом.
//
// В модуле теста:
//     Перем Проверка;
//     Процедура ТестЧтоТо() Экспорт
//         Проверка.Равно(2 + 2, 4);
//     КонецПроцедуры
//     Проверка = Новый Проверка;

Процедура Равно(Факт, Ожидание, Пояснение = "") Экспорт
	Если Факт <> Ожидание Тогда
		Провал(СтрШаблон("ожидалось %1, получено %2", Представление(Ожидание), Представление(Факт)), Пояснение);
	КонецЕсли;
КонецПроцедуры

Процедура Проверить(Условие, Пояснение = "") Экспорт
	Если Не Условие Тогда
		Провал("условие не выполнено", Пояснение);
	КонецЕсли;
КонецПроцедуры

// --- Парсер

// Синтаксическое дерево модуля; если в тексте есть ошибки — провал теста.
Функция Разобрать(Текст) Экспорт
	Парсер = Новый Парсер;
	Попытка
		Модуль = Парсер.Разобрать(Текст);
	Исключение
		Провал(ОписаниеОшибки(), "ошибка разбора");
	КонецПопытки;
	Для Каждого Ошибка Из Парсер.ТаблицаОшибок() Цикл
		Провал(СтрШаблон("%1:%2 %3", Ошибка.НомерСтрокиНачала, Ошибка.НомерКолонкиНачала, Ошибка.Текст), "ошибка разбора");
	КонецЦикла;
	Возврат Модуль;
КонецФункции

// Первый оператор модуля.
Функция Оператор(Текст) Экспорт
	Возврат Разобрать(Текст).Операторы[0];
КонецФункции

// Выражение из присваивания Значение = <Текст>.
Функция Выражение(Текст) Экспорт
	Возврат Оператор("Значение = " + Текст + ";").ПравыйОперанд;
КонецФункции

// Первая ошибка разбора: Структура с полями Код, Строка, Колонка, Текст.
// Если ошибок нет — провал теста.
Функция ОшибкаРазбора(Текст) Экспорт
	Парсер = Новый Парсер;
	Описание = "";
	Попытка
		Парсер.Разобрать(Текст);
	Исключение
		Описание = ОписаниеОшибки(); // разбор останавливается, а ошибка остаётся в таблице
	КонецПопытки;
	Для Каждого Ошибка Из Парсер.ТаблицаОшибок() Цикл
		Возврат Новый Структура("Код, Строка, Колонка, Текст",
			Ошибка.Код, Ошибка.НомерСтрокиНачала, Ошибка.НомерКолонкиНачала, Ошибка.Текст);
	КонецЦикла;
	Провал("ожидалась ошибка разбора " + Описание);
КонецФункции

// --- Служебное

Процедура Провал(Текст, Пояснение = "")
	ВызватьИсключение ?(Пояснение = "", Текст, Пояснение + ": " + Текст);
КонецПроцедуры

Функция Представление(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Значение + """";
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции
