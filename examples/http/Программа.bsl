// java -jar build/juno.jar run examples/http/Программа.bsl localhost 8080 /api ответ.json
Если АргументыКоманднойСтроки.Количество() <> 4 Тогда
    ВызватьИсключение "Нужны host, port, resource и новый файл ответа";
КонецЕсли;

Ответ = Неопределено;
Попытка
    ИмяФайла = АргументыКоманднойСтроки[3];
    Если Новый Файл(ИмяФайла).Существует() Тогда
        ВызватьИсключение "Файл ответа уже существует: " + ИмяФайла;
    КонецЕсли;
    Соединение = Новый HTTPСоединение(АргументыКоманднойСтроки[0],
        Число(АргументыКоманднойСтроки[1]), "", "", Неопределено, 10);
    Запрос = Новый HTTPЗапрос(АргументыКоманднойСтроки[2]);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Токен = ПолучитьПеременнуюСреды("JUNO_HTTP_TOKEN");
    Если Токен <> Неопределено Тогда
        Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    КонецЕсли;
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
    ЗаписатьJSON(Запись, Новый Структура("message,exact", "Привет", 12345678901234567890.12345678));
    Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8БезBOM);
    Ответ = Соединение.ОтправитьДляОбработки(Запрос, ИмяФайла);
    Код = Ответ.КодСостояния;
    Ответ.Закрыть(); // Файл ответа остаётся; private spool освобождается.
    Если Код < 200 Или Код >= 300 Тогда
        ВызватьИсключение "HTTP " + Код + "; тело сохранено в " + ИмяФайла;
    КонецЕсли;
    Консоль.ВывестиСтроку("HTTP " + Код + "; ответ: " + ИмяФайла);
Исключение
    Если Ответ <> Неопределено Тогда Ответ.Закрыть(); КонецЕсли;
    ПотокОшибок = Консоль.ОткрытьСтандартныйПотокОшибок();
    ПолучитьДвоичныеДанныеИзСтроки(ОписаниеОшибки() + Символы.ПС,
        КодировкаТекста.UTF8БезBOM).Записать(ПотокОшибок);
    ПотокОшибок.Закрыть();
    ЗавершитьРаботу(1);
КонецПопытки;
