// java -jar build/juno.jar run examples/mcp/Программа.bsl
// MCP 2025-11-25, stdio: один JSON-RPC объект на строку, без служебного вывода в stdout.
Перем Инициализирован, Готов;

Функция ПрочитатьСообщение(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Попытка
        // Соответствие сохраняет регистр и произвольные имена ключей JSON.
        Значение = ПрочитатьJSON(Чтение, Истина);
    Исключение
        Чтение.Закрыть(); ВызватьИсключение;
    КонецПопытки;
    Чтение.Закрыть();
    Возврат Значение;
КонецФункции

Процедура Отправить(Ответ)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
    Попытка
        ЗаписатьJSON(Запись, Ответ);
    Исключение
        Запись.Закрыть(); ВызватьИсключение;
    КонецПопытки;
    Консоль.ВывестиСтроку(Запись.Закрыть());
КонецПроцедуры

Функция Успех(Идентификатор, Результат)
    Возврат Новый Структура("jsonrpc,id,result", "2.0", Идентификатор, Результат);
КонецФункции

Функция ОшибкаПротокола(Идентификатор, Код, Текст)
    Ошибка = Новый Структура("code,message", Код, Текст);
    Возврат Новый Структура("jsonrpc,id,error", "2.0", Идентификатор, Ошибка);
КонецФункции

Функция ТекстовыйРезультат(Текст, Ошибка = Ложь)
    Содержимое = Новый Массив;
    Содержимое.Добавить(Новый Структура("type,text", "text", Текст));
    Возврат Новый Структура("content,isError", Содержимое, Ошибка);
КонецФункции

Функция Инструменты()
    Список = Новый Массив;
    Свойства = Новый Структура("name", Новый Структура("type,minLength", "string", 1));
    Схема = Новый Структура("type,properties,required,additionalProperties",
        "object", Свойства, СтрРазделить("name", ","), Ложь);
    Список.Добавить(Новый Структура("name,description,inputSchema", "greet", "Поздороваться по имени", Схема));
    Свойства = Новый Структура("a,b", Новый Структура("type", "number"), Новый Структура("type", "number"));
    Схема = Новый Структура("type,properties,required,additionalProperties",
        "object", Свойства, СтрРазделить("a,b", ","), Ложь);
    Список.Добавить(Новый Структура("name,description,inputSchema", "sum", "Сложить два числа точно, без double", Схема));
    Возврат Новый Структура("tools", Список);
КонецФункции

Функция ВызватьИнструмент(Идентификатор, Параметры)
    Имя = Параметры.Получить("name");
    Аргументы = Параметры.Получить("arguments");
    Если ТипЗнч(Имя) <> Тип("Строка") Тогда
        Возврат ОшибкаПротокола(Идентификатор, -32602, "Ожидается имя инструмента");
    КонецЕсли;
    Если Аргументы = Неопределено Тогда Аргументы = Новый Соответствие; КонецЕсли;
    Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
        Возврат ОшибкаПротокола(Идентификатор, -32602, "arguments должен быть объектом");
    КонецЕсли;
    Если Имя = "greet" Тогда
        ИмяГостя = Аргументы.Получить("name");
        Если ТипЗнч(ИмяГостя) <> Тип("Строка") Или ИмяГостя = "" Или Аргументы.Количество() <> 1 Тогда
            Результат = ТекстовыйРезультат("Передайте только name: непустую строку", Истина);
        Иначе
            Результат = ТекстовыйРезультат("Привет, " + ИмяГостя + "!");
        КонецЕсли;
    ИначеЕсли Имя = "sum" Тогда
        А = Аргументы.Получить("a"); Б = Аргументы.Получить("b");
        Если ТипЗнч(А) <> Тип("Число") Или ТипЗнч(Б) <> Тип("Число") Или Аргументы.Количество() <> 2 Тогда
            Результат = ТекстовыйРезультат("Передайте только a и b: два числа", Истина);
        Иначе
            Результат = ТекстовыйРезультат(XMLСтрока(А + Б));
        КонецЕсли;
    Иначе
        Возврат ОшибкаПротокола(Идентификатор, -32602, "Неизвестный инструмент: " + Имя);
    КонецЕсли;
    Возврат Успех(Идентификатор, Результат);
КонецФункции

Функция Обработать(Запрос)
    Если ТипЗнч(Запрос) <> Тип("Соответствие") Тогда
        Возврат ОшибкаПротокола(Null, -32600, "Ожидается объект JSON-RPC");
    КонецЕсли;
    Метод = Запрос.Получить("method");
    Идентификатор = Запрос.Получить("id");
    Если Запрос.Получить("jsonrpc") <> "2.0" Или ТипЗнч(Метод) <> Тип("Строка") Тогда
        Возврат ОшибкаПротокола(Null, -32600, "Неверный запрос JSON-RPC");
    КонецЕсли;
    Если Идентификатор <> Неопределено Тогда
        Если ТипЗнч(Идентификатор) <> Тип("Строка") И ТипЗнч(Идентификатор) <> Тип("Число") Тогда
            Возврат ОшибкаПротокола(Null, -32600, "id должен быть строкой или целым числом");
        КонецЕсли;
        Если ТипЗнч(Идентификатор) = Тип("Число") И Цел(Идентификатор) <> Идентификатор Тогда
            Возврат ОшибкаПротокола(Null, -32600, "id должен быть целым числом");
        КонецЕсли;
    КонецЕсли;
    Параметры = Запрос.Получить("params");
    Если Идентификатор = Неопределено Тогда
        // На уведомления не отвечаем; tools/call без id не выполняется.
        Если Метод = "notifications/initialized" И Инициализирован Тогда Готов = Истина; КонецЕсли;
        Возврат Неопределено;
    КонецЕсли;
    Если Параметры = Неопределено Тогда Параметры = Новый Соответствие; КонецЕсли;
    Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
        Возврат ОшибкаПротокола(Идентификатор, -32602, "params должен быть объектом");
    КонецЕсли;
    Если Метод = "ping" Тогда Возврат Успех(Идентификатор, Новый Структура); КонецЕсли;
    Если Метод = "initialize" Тогда
        Клиент = Параметры.Получить("clientInfo");
        Если ТипЗнч(Параметры.Получить("protocolVersion")) <> Тип("Строка")
            Или ТипЗнч(Параметры.Получить("capabilities")) <> Тип("Соответствие")
            Или ТипЗнч(Клиент) <> Тип("Соответствие") Тогда
            Возврат ОшибкаПротокола(Идентификатор, -32602, "Ожидаются protocolVersion, capabilities и clientInfo");
        КонецЕсли;
        Если ТипЗнч(Клиент.Получить("name")) <> Тип("Строка") Или ТипЗнч(Клиент.Получить("version")) <> Тип("Строка") Тогда
            Возврат ОшибкаПротокола(Идентификатор, -32602, "clientInfo должен содержать name и version");
        КонецЕсли;
        Если Инициализирован Тогда Возврат ОшибкаПротокола(Идентификатор, -32600, "Сервер уже инициализирован"); КонецЕсли;
        Инициализирован = Истина;
        Сервер = Новый Структура("name,version", "juno-mcp-example", "dev");
        Возможности = Новый Структура("tools", Новый Структура);
        Возврат Успех(Идентификатор, Новый Структура("protocolVersion,capabilities,serverInfo", "2025-11-25", Возможности, Сервер));
    КонецЕсли;
    Если Метод <> "tools/list" И Метод <> "tools/call" Тогда
        Возврат ОшибкаПротокола(Идентификатор, -32601, "Неизвестный метод: " + Метод);
    КонецЕсли;
    Если Не Готов Тогда Возврат ОшибкаПротокола(Идентификатор, -32000, "Сначала initialize и notifications/initialized"); КонецЕсли;
    Если Метод = "tools/list" Тогда Возврат Успех(Идентификатор, Инструменты()); КонецЕсли;
    Возврат ВызватьИнструмент(Идентификатор, Параметры);
КонецФункции

Инициализирован = Ложь; Готов = Ложь;
Пока Истина Цикл
    СтрокаВвода = Консоль.ПрочитатьСтроку();
    Если СтрокаВвода = Неопределено Тогда Прервать; КонецЕсли;
    Попытка
        Запрос = ПрочитатьСообщение(СтрокаВвода);
    Исключение
        Отправить(ОшибкаПротокола(Null, -32700, "Невозможно разобрать JSON"));
        Продолжить;
    КонецПопытки;
    Ответ = Обработать(Запрос);
    Если Ответ <> Неопределено Тогда Отправить(Ответ); КонецЕсли;
КонецЦикла;
