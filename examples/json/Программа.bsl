// printf '{"value":1}\nnull\n' | java -jar build/juno.jar run examples/json/Программа.bsl examples/json/Настройки.json
Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
    ВызватьИсключение "Укажите путь к JSON-файлу настроек";
КонецЕсли;

ИменаДат = Новый Массив; ИменаДат.Добавить("created");
Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(АргументыКоманднойСтроки[0], "UTF-8");
Попытка
    Настройки = ПрочитатьJSON(Чтение, Ложь, ИменаДат, ФорматДатыJSON.ISO);
Исключение
    Чтение.Закрыть(); ВызватьИсключение;
КонецПопытки;
Чтение.Закрыть();

Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
Запись = Новый ЗаписьJSON;
Номер = 0;
Попытка
    Пока Истина Цикл
        СтрокаВвода = Консоль.ПрочитатьСтроку();
        Если СтрокаВвода = Неопределено Тогда Прервать; КонецЕсли;
        Номер = Номер + 1;
        // Пустая строка не является JSON-значением: ReadJSON сообщит ошибку с позицией.
        Чтение.УстановитьСтроку(СтрокаВвода);
        Данные = ПрочитатьJSON(Чтение, Истина);
        Запись.УстановитьСтроку(Параметры);
        Результат = Новый Структура("tag,sequence,data,exact,created",
            Настройки.tag, Номер, Данные, Настройки.exact,
            ЗаписатьДатуJSON(Настройки.created, ФорматДатыJSON.ISO));
        ЗаписатьJSON(Запись, Результат);
        Консоль.ВывестиСтроку(Запись.Закрыть());
    КонецЦикла;
Исключение
    Чтение.Закрыть(); Запись.Закрыть();
    ВызватьИсключение "JSONL, строка " + Номер + ": " + ОписаниеОшибки();
КонецПопытки;
Чтение.Закрыть();
