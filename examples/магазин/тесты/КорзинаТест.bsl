// Тесты модуля Корзина: juno test examples/магазин
// Тест — экспортная процедура без параметров, имя начинается с «Тест».
// Тест не прошёл, если выбросил исключение.

Процедура ТестПустаяКорзина() Экспорт
	Покупки = Новый Корзина;
	Если Покупки.Сумма() <> 0 Тогда
		ВызватьИсключение "сумма пустой корзины должна быть 0";
	КонецЕсли;
КонецПроцедуры

Процедура ТестСумма() Экспорт
	Хлеб = Новый Справочники.Товар("Хлеб", 45.50);
	Покупки = Новый Корзина;
	Покупки.Добавить(Хлеб, 2);
	Если Покупки.Сумма() <> 91 Тогда
		ВызватьИсключение "ожидалось 91, получено " + Покупки.Сумма();
	КонецЕсли;
КонецПроцедуры
