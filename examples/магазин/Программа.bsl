// Программа из трёх модулей. Каждый модуль — класс:
//   Корзина.bsl            → Новый Корзина
//   Справочники/Товар.bsl  → Новый Справочники.Товар
//
// juno run examples/магазин/Программа.bsl
// juno build examples/магазин/Программа.bsl  →  java -jar Программа.jar

Хлеб = Новый Справочники.Товар("Хлеб", 45.50);
Молоко = Новый Справочники.Товар("Молоко", 89.90);

Покупки = Новый Корзина;
Покупки.Добавить(Хлеб, 2);
Покупки.Добавить(Молоко, 1);

Для Каждого Строка Из Покупки.Строки() Цикл
	Сообщить(Строка);
КонецЦикла;
Сообщить("Итого: " + Покупки.Сумма());
