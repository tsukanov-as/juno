// Модуль Корзина — класс Корзина.
// Переменная без Экспорт видна только внутри модуля, как в модуле объекта.

Перем Позиции;

Процедура Добавить(Товар, Количество) Экспорт
	Позиции.Добавить(Новый Структура("Товар, Количество", Товар, Количество));
КонецПроцедуры

Функция Сумма() Экспорт
	Итого = 0;
	Для Каждого Позиция Из Позиции Цикл
		Итого = Итого + Позиция.Товар.Цена * Позиция.Количество;
	КонецЦикла;
	Возврат Итого;
КонецФункции

Функция Строки() Экспорт
	Результат = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Результат.Добавить(СтрШаблон("%1 × %2", Позиция.Товар.Представление(), Позиция.Количество));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Операторы в конце модуля выполняются при создании объекта: Новый Корзина.
Позиции = Новый Массив;
