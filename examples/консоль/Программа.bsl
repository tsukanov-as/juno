// printf 'Привет\n\nмир\n' | java -jar build/juno.jar run examples/консоль/Программа.bsl
// JUNO_PREFIX='> ' добавляет префикс. --bytes копирует stdin без преобразования байтов.
Если АргументыКоманднойСтроки.Количество() > 0 И АргументыКоманднойСтроки[0] = "--bytes" Тогда
    Ввод = Консоль.ОткрытьСтандартныйПотокВвода();
    Вывод = Консоль.ОткрытьСтандартныйПотокВывода();
    Буфер = Новый БуферДвоичныхДанных(65536);
    Попытка
        Пока Истина Цикл
            Количество = Ввод.Прочитать(Буфер, 0, Буфер.Размер);
            Если Количество = 0 Тогда Прервать; КонецЕсли;
            Вывод.Записать(Буфер, 0, Количество);
        КонецЦикла;
    Исключение
        Ввод.Закрыть(); Вывод.Закрыть(); ВызватьИсключение;
    КонецПопытки;
    Ввод.Закрыть(); Вывод.Закрыть();
Иначе
    Префикс = ПолучитьПеременнуюСреды("JUNO_PREFIX");
    Если Префикс = Неопределено Тогда Префикс = ""; КонецЕсли;
    Пока Истина Цикл
        СтрокаВвода = Консоль.ПрочитатьСтроку();
        Если СтрокаВвода = Неопределено Тогда Прервать; КонецЕсли;
        Консоль.ВывестиСтроку(Префикс + ВРег(СтрокаВвода));
    КонецЦикла;
КонецЕсли;
