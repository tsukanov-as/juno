// juno run examples/файлы/Программа.bsl источник.bin копия.bin
Если АргументыКоманднойСтроки.Количество() <> 2 Тогда
    Сообщить("Укажите исходный и выходной файлы");
    ЗавершитьРаботу(2);
КонецЕсли;

Источник = Новый ФайловыйПоток(АргументыКоманднойСтроки[0],РежимОткрытияФайла.Открыть,ДоступКФайлу.Чтение);
Приемник = Неопределено;
Попытка
    Приемник = Новый ФайловыйПоток(АргументыКоманднойСтроки[1],РежимОткрытияФайла.СоздатьНовый,ДоступКФайлу.Запись);
    Буфер = Новый БуферДвоичныхДанных(65536);
    Всего = 0;
    Пока Истина Цикл
        Количество = Источник.Прочитать(Буфер,0,Буфер.Размер);
        Если Количество = 0 Тогда Прервать; КонецЕсли;
        Приемник.Записать(Буфер,0,Количество);
        Всего = Всего + Количество;
    КонецЦикла;
Исключение
    Источник.Закрыть();
    Если Приемник <> Неопределено Тогда Приемник.Закрыть(); КонецЕсли;
    ВызватьИсключение;
КонецПопытки;
Источник.Закрыть(); Приемник.Закрыть();

// Отдельный небольшой текстовый отчёт; двоичный файл в память целиком не загружается.
Отчет = АргументыКоманднойСтроки[1] + ".txt";
Запись = Новый ЗаписьТекста(Отчет);
Попытка
    Запись.ЗаписатьСтроку("Скопировано байт: " + Всего);
    Запись.ЗаписатьСтроку("Проверено: " + XMLСтрока(ТекущаяУниверсальнаяДата()));
Исключение
    Запись.Закрыть(); ВызватьИсключение;
КонецПопытки;
Запись.Закрыть();
Чтение = Новый ЧтениеТекста(Отчет);
Попытка
    Пока Истина Цикл
        СтрокаОтчета = Чтение.ПрочитатьСтроку();
        Если СтрокаОтчета = Неопределено Тогда Прервать; КонецЕсли;
        Сообщить(СтрокаОтчета);
    КонецЦикла;
Исключение
    Чтение.Закрыть(); ВызватьИсключение;
КонецПопытки;
Чтение.Закрыть();
