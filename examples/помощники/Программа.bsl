// Подготовка записи к обработке без платформы 1С и внешних библиотек.
ИсходнаяЗапись = Новый Структура("ИД,Название,Сумма,Лишнее",
    Новый УникальныйИдентификатор("aabbccdd-1122-3344-5566-778899aabbcc"), "Поставка", 225, "внутреннее");
Запись = Новый Структура("ИД,Название,Сумма", Неопределено, "", 0);
ЗаполнитьЗначенияСвойств(Запись, ИсходнаяЗапись);
Сообщить("ID: " + XMLСтрока(Запись.ИД));
Сообщить(СтрШаблон("%1: %2", Запись.Название, Запись.Сумма));

Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
Хеш.Добавить(XMLСтрока(Запись.ИД)); Хеш.Добавить(Запись.Название);
Сообщить("SHA256: " + ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
Сообщить("Расстояние: " + Строка(Sqrt(Pow(3, 2) + Pow(4, 2))));
ДатаЗаписи = Дата(2024, 2, 29, 12, 34, 56);
Сообщить("Конец недели: " + XMLСтрока(КонецНедели(ДатаЗаписи)));
Генератор = Новый ГенераторСлучайныхЧисел(42);
Число = Генератор.СлучайноеЧисло(1, 10);
Сообщить("Число в диапазоне 1..10: " + Строка(Число));
