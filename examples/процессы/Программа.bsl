Процедура СкопироватьВывод(Источник, Приемник, Буфер)
    Пока Истина Цикл
        Прочитано = Источник.ПрочитатьБайты(Буфер,0,Буфер.Размер);
        Если Прочитано=0 Тогда Прервать; КонецЕсли;
        Приемник.Записать(Буфер,0,Прочитано);
    КонецЦикла;
КонецПроцедуры

// ... input.bin stdout.bin stderr.bin executable [args...]
Если АргументыКоманднойСтроки.Количество() < 4 Тогда
    ВызватьИсключение "Нужны input, новый stdout-файл, новый stderr-файл и executable [args...]";
КонецЕсли;



Процесс=Неопределено; Вход=Неопределено; Выход=Неопределено; Ошибки=Неопределено;
Попытка
    Вход=Новый ФайловыйПоток(АргументыКоманднойСтроки[0],РежимОткрытияФайла.Открыть,ДоступКФайлу.Чтение);
    Выход=Новый ФайловыйПоток(АргументыКоманднойСтроки[1],РежимОткрытияФайла.СоздатьНовый,ДоступКФайлу.Запись);
    Ошибки=Новый ФайловыйПоток(АргументыКоманднойСтроки[2],РежимОткрытияФайла.СоздатьНовый,ДоступКФайлу.Запись);
    Аргументы=Новый Массив;
    Для Индекс=3 По АргументыКоманднойСтроки.Количество()-1 Цикл
        Аргументы.Добавить(АргументыКоманднойСтроки[Индекс]);
    КонецЦикла;
    // Отдельный argv API сохраняет пробелы, пустые строки и кавычки без shell parsing.
    Процесс=СоздатьПроцессСАргументами(Аргументы,"",Истина,Истина);
    Процесс.Запустить();
    Буфер=Новый БуферДвоичныхДанных(65536);
    Пока Истина Цикл
        Прочитано=Вход.Прочитать(Буфер,0,Буфер.Размер);
        Если Прочитано=0 Тогда Прервать; КонецЕсли;
        Процесс.ПотокВвода.ЗаписатьБайты(Буфер,0,Прочитано);
    КонецЦикла;
    Вход.Закрыть(); Процесс.ПотокВвода.Закрыть(); // EOF child, никогда не host stdin.
    Процесс.ОжидатьЗавершения();
    СкопироватьВывод(Процесс.ПотокВывода,Выход,Буфер);
    СкопироватьВывод(Процесс.ПотокОшибок,Ошибки,Буфер);
    Код=Процесс.КодВозврата;
    Выход.Закрыть(); Ошибки.Закрыть(); Процесс.Закрыть();
    ЗавершитьРаботу(Код);
Исключение
    ТекстОшибки=ОписаниеОшибки();
    Если Процесс<>Неопределено Тогда Процесс.Закрыть(); КонецЕсли;
    Если Вход<>Неопределено Тогда Вход.Закрыть(); КонецЕсли;
    Если Выход<>Неопределено Тогда Выход.Закрыть(); КонецЕсли;
    Если Ошибки<>Неопределено Тогда Ошибки.Закрыть(); КонецЕсли;
    Поток=Консоль.ОткрытьСтандартныйПотокОшибок();
    ПолучитьДвоичныеДанныеИзСтроки(ТекстОшибки+Символы.ПС,КодировкаТекста.UTF8БезBOM).Записать(Поток);
    Поток.Закрыть(); ЗавершитьРаботу(1);
КонецПопытки;
