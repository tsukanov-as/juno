// Модуль с типичными ошибками — для примеров плагинов.
// juno lint examples/проверка --plugin plugins

Процедура ОбновитьЦены(Товары)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.Цены ГДЕ Номенклатура = &Товар";
	Для Каждого Товар Из Товары Цикл
		Запрос.УстановитьПараметр("Товар", Товар);
		Выборка = Запрос.Выполнить().Выбрать();
	КонецЦикла;
КонецПроцедуры

Процедура Сохранить(Объект)
	Попытка
		Объект.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура Удалить(Объект)
	Если Вопрос("Удалить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Попытка
			Объект.Удалить();
		Исключение
			Сообщить("Не удалось удалить");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры
