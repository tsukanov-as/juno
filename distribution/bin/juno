#!/bin/sh
# The distribution can be moved; application paths remain relative to the caller.
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 3
if [ -n "${JAVA_HOME:-}" ]; then java="$JAVA_HOME/bin/java"; else java=java; fi
version=$("$java" -version 2>&1) || { printf '%s\n' "$version" >&2; exit 2; }
major=$(printf '%s\n' "$version" | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -n 1)
case "$major" in ''|*[!0-9]*) printf '%s\n' 'juno requires JDK 21+; set JAVA_HOME.' >&2; exit 2;; esac
if [ "$major" -lt 21 ]; then printf '%s\n' 'juno requires JDK 21+; set JAVA_HOME.' >&2; exit 2; fi
exec "$java" -jar "$base/lib/juno.jar" "$@"
