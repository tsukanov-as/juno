// Подавление исключений: ошибка перехвачена в Попытка ... Исключение и потеряна.
// Блок Исключение должен хоть как-то использовать ошибку: передать её дальше
// (ВызватьИсключение), записать в журнал регистрации или показать
// её описание — ИнформацияОбОшибке() или ОписаниеОшибки(). Иначе что сломалось,
// уже никто не узнает.
//
// Параметр Обработчики — свои процедуры, которые тоже обрабатывают ошибку,
// через запятую: "ОбщегоНазначения.ЗаписатьОшибку, ЗаписатьВЛог".

Перем ТаблицаОшибок;
Перем Типы;
Перем Обработчики; // имя вызова в нижнем регистре -> Истина
Перем Блоки;       // для каждого открытого блока Исключение: обработана ли в нём ошибка

Процедура Открыть(Парсер, Параметры) Экспорт
	ТаблицаОшибок = Парсер.ТаблицаОшибок();
	Типы = Парсер.Типы();
	Список = "ИнформацияОбОшибке, ОписаниеОшибки, ЗаписьЖурналаРегистрации, ErrorInfo, ErrorDescription, WriteLogEvent";
	Если Параметры <> Неопределено И Параметры.Свойство("Обработчики") Тогда
		Список = Список + "," + Параметры.Обработчики;
	КонецЕсли;
	Обработчики = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Список, ",", Ложь) Цикл
		Обработчики.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;
	Блоки = Новый Массив;
КонецПроцедуры

Функция Закрыть() Экспорт
	Возврат Неопределено;
КонецФункции

Функция Подписки() Экспорт
	Подписки = Новый Массив;
	Подписки.Добавить("ПосетитьОператорИсключение");
	Подписки.Добавить("ПокинутьОператорИсключение");
	Подписки.Добавить("ПосетитьОператорВызватьИсключение");
	Подписки.Добавить("ПосетитьВыражениеИдентификатор");
	Возврат Подписки;
КонецФункции

// Посетить... вызывается при входе в узел, Покинуть... — когда обойдено всё внутри него.

Процедура ПосетитьОператорИсключение(Блок) Экспорт
	Блоки.Добавить(Ложь);
КонецПроцедуры

Процедура ПокинутьОператорИсключение(Блок) Экспорт
	Обработана = Блоки[Блоки.ВГраница()];
	Блоки.Удалить(Блоки.ВГраница());
	Если Блок.Операторы.Количество() = 0 Тогда
		Ошибка("Пустой блок Исключение: ошибка теряется", Блок);
	ИначеЕсли Не Обработана Тогда
		Ошибка("Ошибка теряется: блок Исключение не использует ни ВызватьИсключение, ни ИнформацияОбОшибке(), ни ОписаниеОшибки()", Блок);
	КонецЕсли;
КонецПроцедуры

Процедура ПосетитьОператорВызватьИсключение(Оператор) Экспорт
	Обработать();
КонецПроцедуры

// Вызов процедуры: ЗаписатьОшибку(...) или ОбщегоНазначения.ЗаписатьОшибку(...).
Процедура ПосетитьВыражениеИдентификатор(Выражение) Экспорт
	Если Блоки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Имя = Выражение.Голова.Имя;
	Если Выражение.Аргументы <> Неопределено Тогда
		Проверить(Имя, Имя);
	КонецЕсли;
	Для Каждого Элемент Из Выражение.Хвост Цикл
		Если Элемент.Тип <> Типы.ВыражениеПоле Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + "." + Элемент.Имя;
		Если Элемент.Аргументы <> Неопределено Тогда
			Проверить(Имя, Элемент.Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Проверить(ПолноеИмя, Имя)
	Если Обработчики[НРег(ПолноеИмя)] = Истина Или Обработчики[НРег(Имя)] = Истина Тогда
		Обработать();
	КонецЕсли;
КонецПроцедуры

Процедура Обработать()
	Если Блоки.Количество() > 0 Тогда
		Блоки[Блоки.ВГраница()] = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура Ошибка(Текст, Узел)
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.Источник = "ПодавлениеИсключений";
	Ошибка.Текст = Текст;
	Ошибка.ПозицияНачала = Узел.Начало.Позиция;
	Ошибка.НомерСтрокиНачала = Узел.Начало.НомерСтроки;
	Ошибка.НомерКолонкиНачала = Узел.Начало.НомерКолонки;
	Ошибка.ПозицияКонца = Узел.Начало.Позиция + Узел.Начало.Длина;
	Ошибка.НомерСтрокиКонца = Узел.Начало.НомерСтроки;
	Ошибка.НомерКолонкиКонца = Узел.Начало.НомерКолонки + Узел.Начало.Длина;
КонецПроцедуры
