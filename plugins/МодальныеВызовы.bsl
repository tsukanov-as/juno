// Модальные вызовы: Вопрос, Предупреждение, ВвестиЧисло и другие.
// Модальное окно блокирует интерфейс, а в конфигурации с режимом
// «Не использовать модальность» такой вызов завершается ошибкой.
// Плагин подсказывает, чем заменить каждый вызов.
//
// Самый простой вид проверки — список запрещённых методов.
// По его образцу легко запретить что-то своё.

Перем ТаблицаОшибок;
Перем Замены; // имя метода в нижнем регистре -> на что заменить

Процедура Открыть(Парсер, Параметры) Экспорт
	ТаблицаОшибок = Парсер.ТаблицаОшибок();
	Замены = Новый Соответствие;
	Заменить("Вопрос", "DoQueryBox", "ВопросАсинх");
	Заменить("Предупреждение", "DoMessageBox", "ПредупреждениеАсинх");
	Заменить("ОткрытьФормуМодально", "OpenFormModal", "ОткрытьФорму с ОписаниеОповещения");
	Заменить("ОткрытьЗначение", "OpenValue", "ПоказатьЗначение");
	Заменить("ВвестиЗначение", "InputValue", "ПоказатьВводЗначения");
	Заменить("ВвестиЧисло", "InputNumber", "ПоказатьВводЧисла");
	Заменить("ВвестиСтроку", "InputString", "ПоказатьВводСтроки");
	Заменить("ВвестиДату", "InputDate", "ПоказатьВводДаты");
КонецПроцедуры

Процедура Заменить(Имя, ИмяАнгл, НаЧто)
	Замены.Вставить(НРег(Имя), НаЧто);
	Замены.Вставить(НРег(ИмяАнгл), НаЧто);
КонецПроцедуры

Функция Закрыть() Экспорт
	Возврат Неопределено;
КонецФункции

Функция Подписки() Экспорт
	Подписки = Новый Массив;
	Подписки.Добавить("ПосетитьВыражениеИдентификатор");
	Возврат Подписки;
КонецФункции

Процедура ПосетитьВыражениеИдентификатор(Выражение) Экспорт
	// Нужен вызов глобального метода: Вопрос(...), а не Объект.Вопрос(...).
	Если Выражение.Аргументы = Неопределено Или Выражение.Хвост.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	// Свой метод с таким же именем, объявленный в модуле, — не модальный вызов.
	Если Выражение.Голова.Объявление <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	НаЧто = Замены[НРег(Выражение.Голова.Имя)];
	Если НаЧто <> Неопределено Тогда
		Ошибка(СтрШаблон("Модальный вызов %1(): используйте %2", Выражение.Голова.Имя, НаЧто), Выражение);
	КонецЕсли;
КонецПроцедуры

Процедура Ошибка(Текст, Узел)
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.Источник = "МодальныеВызовы";
	Ошибка.Текст = Текст;
	Ошибка.ПозицияНачала = Узел.Начало.Позиция;
	Ошибка.НомерСтрокиНачала = Узел.Начало.НомерСтроки;
	Ошибка.НомерКолонкиНачала = Узел.Начало.НомерКолонки;
	Ошибка.ПозицияКонца = Узел.Конец.Позиция + Узел.Конец.Длина;
	Ошибка.НомерСтрокиКонца = Узел.Конец.НомерСтроки;
	Ошибка.НомерКолонкиКонца = Узел.Конец.НомерКолонки + Узел.Конец.Длина;
КонецПроцедуры
