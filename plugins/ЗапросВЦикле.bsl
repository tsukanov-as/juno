// Запрос в цикле: запрос к базе выполняется на каждой итерации.
// Обычно такой код переписывается одним запросом с отбором по списку
// или через временную таблицу — и становится быстрее в разы.
//
// Плагин запоминает переменные метода, которым присвоен Новый Запрос,
// и сообщает, если их Выполнить() или ВыполнитьПакет() вызывается внутри цикла.

Перем ТаблицаОшибок;
Перем Типы;
Перем Счетчики;
Перем Запросы; // имя переменной в нижнем регистре -> Истина, если в ней запрос

Процедура Открыть(Парсер, Параметры) Экспорт
	ТаблицаОшибок = Парсер.ТаблицаОшибок();
	Типы = Парсер.Типы();
	Счетчики = Парсер.Счетчики();
	Запросы = Новый Соответствие;
КонецПроцедуры

Функция Закрыть() Экспорт
	Возврат Неопределено;
КонецФункции

Функция Подписки() Экспорт
	Подписки = Новый Массив;
	Подписки.Добавить("ПосетитьОбъявлениеМетода");
	Подписки.Добавить("ПосетитьОператорПрисваивания");
	Подписки.Добавить("ПосетитьВыражениеИдентификатор");
	Возврат Подписки;
КонецФункции

Процедура ПосетитьОбъявлениеМетода(ОбъявлениеМетода) Экспорт
	Запросы = Новый Соответствие; // у каждого метода свои переменные
КонецПроцедуры

Процедура ПосетитьОператорПрисваивания(Присваивание) Экспорт
	Слева = Присваивание.ЛевыйОперанд;
	Если Слева.Хвост.Количество() > 0 Тогда
		Возврат; // присваивание полю: Объект.Поле = ...
	КонецЕсли;
	Справа = Присваивание.ПравыйОперанд;
	ЭтоЗапрос = Справа.Тип = Типы.ВыражениеНовый
		И Справа.Имя <> Неопределено
		И (НРег(Справа.Имя) = "запрос" Или НРег(Справа.Имя) = "query");
	Запросы.Вставить(НРег(Слева.Голова.Имя), ЭтоЗапрос);
КонецПроцедуры

Процедура ПосетитьВыражениеИдентификатор(Выражение) Экспорт
	Если Выражение.Хвост.Количество() = 0 Или Запросы[НРег(Выражение.Голова.Имя)] <> Истина Тогда
		Возврат;
	КонецЕсли;
	Метод = Выражение.Хвост[0]; // Запрос.Выполнить()
	Если Метод.Тип <> Типы.ВыражениеПоле Или Метод.Аргументы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Имя = НРег(Метод.Имя);
	Выполняется = Имя = "выполнить" Или Имя = "выполнитьпакет" Или Имя = "execute" Или Имя = "executebatch";
	Если Выполняется И ВЦикле() Тогда
		Ошибка("Запрос выполняется в цикле", Выражение);
	КонецЕсли;
КонецПроцедуры

Функция ВЦикле()
	Возврат Счетчики.ОператорДля + Счетчики.ОператорДляКаждого + Счетчики.ОператорПока > 0;
КонецФункции

Процедура Ошибка(Текст, Узел)
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.Источник = "ЗапросВЦикле";
	Ошибка.Текст = Текст;
	Ошибка.ПозицияНачала = Узел.Начало.Позиция;
	Ошибка.НомерСтрокиНачала = Узел.Начало.НомерСтроки;
	Ошибка.НомерКолонкиНачала = Узел.Начало.НомерКолонки;
	Ошибка.ПозицияКонца = Узел.Конец.Позиция + Узел.Конец.Длина;
	Ошибка.НомерСтрокиКонца = Узел.Конец.НомерСтроки;
	Ошибка.НомерКолонкиКонца = Узел.Конец.НомерКолонки + Узел.Конец.Длина;
КонецПроцедуры
