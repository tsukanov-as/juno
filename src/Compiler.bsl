        КонецЕсли;
        ЦиклОписание = Циклы[Циклы.Количество() - 1];
        Переход(167, ?(Вид = Типы.ОператорПрервать, ЦиклОписание.Конец, ЦиклОписание.Продолжить));
    ИначеЕсли Вид = Типы.ОператорВызватьИсключение Тогда
        Если Узел.Выражение = Неопределено И Обработчики.Количество() > 0 Тогда
