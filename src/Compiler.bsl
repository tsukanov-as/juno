// juno: прямой генератор классов JVM на встроенном языке 1С.
Перем Пул, КэшПула, Методы, Поля, ОбъявленияМетодов, Константы, ИндексыПолей, ТочкиВызовов;
Перем Код, Слоты, СлотыЗначений, НужныСсылки, СледующийСлот, Переходы, Метки, Исключения, Циклы, ИменованныеМетки, Обработчики, КонтекстыМеток;
Перем Типы, Токены, Исходник, Класс, ЭтоФункция, ОперацииRuntime;
Перем СтрокиКода;
Перем Глубина, МаксГлубина, ГлубиныМеток, ЭффектыКоманд, ЭффектыДескрипторов;
Перем ШирокиеПереходы, ПовторПриПереполнении, ТекущееОбъявление;
Перем ТокенКомпиляции Экспорт;
Перем НужнаПроверкаОтмены, СлотОтмены;
Перем ИмяИсходника Экспорт;
// Символы препроцессора через запятую, например "Сервер,НаСервере"; Неопределено —
// окружение не задано, и условные инструкции препроцессора являются ошибкой.
Перем ОкружениеКомпиляции Экспорт;
Перем ИменаСимволов, ОпределенныеСимволы;
// Неопределено у bootstrap старого поколения: проверку включает фасад Juno.
Перем СигнатурыГлобальныхФункций Экспорт;
Перем ДоступныеТипы Экспорт;
Перем ГлобальныеЗначения Экспорт;

Функция Скомпилировать(Парсер, Модуль, ИмяКласса) Экспорт
    ТокенКомпиляции = Неопределено;
    Типы = Парсер.Типы();
    Токены = Парсер.Токены();
    Исходник = Парсер.Исходник();
    ПодготовитьПрепроцессор(Парсер);
    ОперацииRuntime = Новый Соответствие;
    Для Каждого Пара Из Новый Структура("ЗнакСложения,ЗнакВычитания,ЗнакУмножения,ЗнакДеления,ЗнакОстатка,ЗнакРавно,ЗнакНеРавно,ЗнакМеньше,ЗнакБольше,ЗнакМеньшеИлиРавно,ЗнакБольшеИлиРавно",
        "add", "subtract", "multiply", "divide", "remainder", "eq", "ne", "lt", "gt", "le", "ge") Цикл
        ОперацииRuntime.Вставить(Пара.Ключ, Пара.Значение);
    КонецЦикла;
    Класс = СтрЗаменить(ИмяКласса, ".", "/");
    // Изменение глубины стека JVM для команд без дескриптора (код:эффект).
    ЭффектыКоманд = Новый Соответствие;
    Для Каждого Пара Из СтрРазделить("0:0,3:1,4:1,5:1,6:1,7:1,8:1,16:1,17:1,18:1,19:1,21:1,25:1,26:1,27:1,28:1,29:1,42:1,43:1,44:1,45:1,"
        + "50:-1,54:-1,58:-1,59:-1,60:-1,61:-1,62:-1,75:-1,76:-1,77:-1,78:-1,83:-3,87:-1,89:1,95:0,130:-1,132:0,"
        + "153:-1,154:-1,167:0,170:-1,176:-1,177:0,178:1,179:-1,180:0,181:-2,187:1,189:0,191:-1,196:0,200:0", ",") Цикл
        Части = СтрРазделить(Пара, ":");
        ЭффектыКоманд.Вставить(Число(Части[0]), Число(Части[1]));
    КонецЦикла;
    ЭффектыДескрипторов = Новый Соответствие;
    Пул = Новый Массив;
    КэшПула = Новый Соответствие;
    Методы = Новый Массив;
    Поля = Новый Соответствие;
    ИндексыПолей = Новый Соответствие;
    ОбъявленияМетодов = Новый Соответствие;
    Константы = Новый Соответствие;
    ТочкиВызовов = Новый Массив;
    Для Каждого Переменная Из Модуль.Переменные Цикл
        Если СтрНайти(НРег(Переменная.Имя), "__juno_") = 1 Тогда
            ВызватьИсключение "Зарезервированное имя " + Переменная.Имя;
        КонецЕсли;
        ИндексыПолей.Вставить(НРег(Переменная.Имя), Поля.Количество());
        Поля.Вставить(НРег(Переменная.Имя), Переменная);
        UTF(Переменная.Имя);
    КонецЦикла;
    // Условие может открываться среди объявлений и закрываться после тела модуля.
    СостояниеМодуля = СостояниеПрепроцессора();
    АктивныеОбъявления = ОтобратьАктивные(Модуль.Объявления, СостояниеМодуля);
    ОператорыМодуля = ОтобратьАктивные(Модуль.Операторы, СостояниеМодуля);
    ЗакрытьПрепроцессор(СостояниеМодуля);
    Для Каждого Объявление Из АктивныеОбъявления Цикл
        ТокенКомпиляции = Объявление.Начало;
        Если Объявление.Тип = Типы.ОбъявлениеМетода Тогда
            Если Объявление.Сигнатура.Асинх Тогда
                ВызватьИсключение "Асинх/Ждать пока не поддержаны генератором байткода Juno";
            КонецЕсли;
            Если СтрНайти(НРег(Объявление.Сигнатура.Имя), "__juno_") = 1 Тогда
                ВызватьИсключение "Зарезервированное имя " + Объявление.Сигнатура.Имя;
            КонецЕсли;
            ОбъявленияМетодов.Вставить(НРег(Объявление.Сигнатура.Имя), Объявление);
        ИначеЕсли Объявление.Тип <> Типы.ОбъявлениеСпискаПеременныхМодуля
            И Объявление.Тип <> Типы.ИнструкцияПрепроцессораОбласть
            И Объявление.Тип <> Типы.ИнструкцияПрепроцессораКонецОбласти Тогда
            ВызватьИсключение "Не поддерживается объявление " + Объявление.Тип;
        КонецЕсли;
    КонецЦикла;
    СгенерироватьКонструктор();
    ШирокиеПереходы = Ложь;
    ПовторПриПереполнении = Ложь;
    Для Каждого Пара Из ОбъявленияМетодов Цикл
        СгенерироватьСПовтором(Пара.Значение, Неопределено);
    КонецЦикла;
    СгенерироватьСПовтором(Неопределено, ОператорыМодуля);
    СгенерироватьСвязывание();
    СгенерироватьКонстанты();

    ИндексКласса = CPКласс(Класс);
    ИндексРодителя = CPКласс("java/lang/Object");
    ИндексИнтерфейса = CPКласс("juno/runtime/RuntimeSupport$Module");
    UTF("Ljava/lang/Object;");
    UTF("Code");
    ИндексSourceFile = UTF("SourceFile");
    ИндексИмениИсходника = UTF(?(ИмяИсходника = Неопределено Или ИмяИсходника = "", Класс + ".bsl", ИмяИсходника));
    Результат = Новый Массив;
    U4(Результат, 3405691582);
    U2(Результат, 0);
    U2(Результат, 49); // корректный legacy-формат, проверяется современным JVM verifier
    U2(Результат, Пул.Количество() + 1);
    Для Каждого Элемент Из Пул Цикл
        ДобавитьБайты(Результат, Элемент);
    КонецЦикла;
    U2(Результат, 33); // public + super
    U2(Результат, ИндексКласса);
    U2(Результат, ИндексРодителя);
    U2(Результат, 1);
    U2(Результат, ИндексИнтерфейса);
    U2(Результат, Поля.Количество() + Константы.Количество() + ТочкиВызовов.Количество());
    Для Каждого Пара Из Поля Цикл
        Переменная = Пара.Значение;
        ЕстьЭкспорт = Ложь;
        Если Переменная.Тип = Типы.ОбъявлениеПеременнойМодуля Тогда
            ЕстьЭкспорт = Переменная.Экспорт;
        КонецЕсли;
        U2(Результат, ?(ЕстьЭкспорт, 1, 2));
        U2(Результат, UTF(Переменная.Имя));
        U2(Результат, UTF("Ljava/lang/Object;"));
        U2(Результат, 0);
    КонецЦикла;
    Для Каждого Пара Из Константы Цикл
        U2(Результат, 4122); // private static final synthetic
        U2(Результат, UTF(Пара.Значение.Имя));
        U2(Результат, UTF(Пара.Значение.Дескриптор));
        U2(Результат, 0);
    КонецЦикла;
    Для Индекс = 0 По ТочкиВызовов.Количество() - 1 Цикл
        // final возможен, только если все поля заполняет сам <clinit>.
        U2(Результат, ?(ТочкиВызовов.Количество() <= ПорцияТочекВызова(), 4122, 4106)); // private static [final] synthetic
        U2(Результат, UTF("__juno_call_" + Строка(Индекс)));
        U2(Результат, UTF("Ljuno/runtime/RuntimeSupport$MethodSite;"));
        U2(Результат, 0);
    КонецЦикла;
    U2(Результат, Методы.Количество());
    Для Каждого Метод Из Методы Цикл
        ДобавитьБайты(Результат, Метод);
    КонецЦикла;
    U2(Результат, 1);
    U2(Результат, ИндексSourceFile);
    U4(Результат, 2);
    U2(Результат, ИндексИмениИсходника);
    Hex = Новый Массив;
    Цифры = "0123456789ABCDEF";
    Для Каждого Байт Из Результат Цикл
        Hex.Добавить(Сред(Цифры, Цел(Байт / 16) + 1, 1) + Сред(Цифры, Байт % 16 + 1, 1));
    КонецЦикла;
    Возврат ПолучитьДвоичныеДанныеИзHexСтроки(СтрСоединить(Hex));
КонецФункции

Процедура ПодготовитьПрепроцессор(Парсер)
    ИменаСимволов = Парсер.СимволыПрепроцессора(); // русское и английское имя -> русское
    ОпределенныеСимволы = Неопределено;
    Если ОкружениеКомпиляции = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ОпределенныеСимволы = Новый Соответствие;
    Для Каждого Имя Из СтрРазделить(ОкружениеКомпиляции, ",", Ложь) Цикл
        Символ = Неопределено;
        Если Не ИменаСимволов.Свойство(СокрЛП(Имя), Символ) Тогда
            ВызватьИсключение "Неизвестный символ препроцессора в окружении: " + СокрЛП(Имя);
        КонецЕсли;
        ОпределенныеСимволы.Вставить(Символ, Истина);
    КонецЦикла;
КонецПроцедуры

// Условный препроцессор: остаются узлы активных ветвей, сами инструкции #Если удаляются.
// Инструкции идут плоскими маркерами в том же списке, что объявления или операторы.
Функция АктивныеУзлы(Список)
    Состояние = СостояниеПрепроцессора();
    Результат = ОтобратьАктивные(Список, Состояние);
    ЗакрытьПрепроцессор(Состояние);
    Возврат Результат;
КонецФункции

Функция СостояниеПрепроцессора()
    Возврат Новый Структура("Уровни,Активна", Новый Массив, Истина);
КонецФункции

// Инструкции препроцессора компилятор вычисляет по AST: они должны охватывать
// целые операторы или объявления. Разрезанный ими оператор — синтаксическая ошибка.
Процедура ЗакрытьПрепроцессор(Состояние)
    Если Состояние.Уровни.Количество() > 0 Тогда
        ТокенКомпиляции = Состояние.Уровни[Состояние.Уровни.Количество() - 1].Начало;
        ВызватьИсключение "#Если без #КонецЕсли в том же блоке: " + ТребованиеПрепроцессора();
    КонецЕсли;
КонецПроцедуры

Функция ТребованиеПрепроцессора()
    Возврат "инструкции препроцессора должны охватывать целые операторы";
КонецФункции

Функция ЭтоУсловиеПрепроцессора(Вид)
    Возврат Вид = Типы.ИнструкцияПрепроцессораЕсли Или Вид = Типы.ИнструкцияПрепроцессораИначеЕсли
        Или Вид = Типы.ИнструкцияПрепроцессораИначе Или Вид = Типы.ИнструкцияПрепроцессораКонецЕсли;
КонецФункции

Функция ОтобратьАктивные(Список, Состояние)
    ЕстьУсловия = Состояние.Уровни.Количество() > 0;
    Для Каждого Узел Из Список Цикл
        Если ЕстьУсловия Тогда
            Прервать;
        КонецЕсли;
        ЕстьУсловия = ЭтоУсловиеПрепроцессора(Узел.Тип);
    КонецЦикла;
    Если Не ЕстьУсловия Тогда
        Возврат Список;
    КонецЕсли;
    Результат = Новый Массив;
    Уровни = Состояние.Уровни;
    Для Каждого Узел Из Список Цикл
        Вид = Узел.Тип;
        Если Вид = Типы.ИнструкцияПрепроцессораЕсли Тогда
            ТокенКомпиляции = Узел.Начало;
            Условие = ЗначениеПрепроцессора(Узел.Выражение);
            Уровни.Добавить(Новый Структура("Внешняя,Выбрана,Начало", Состояние.Активна, Условие, Узел.Начало));
            Состояние.Активна = Состояние.Активна И Условие;
        ИначеЕсли ЭтоУсловиеПрепроцессора(Вид) Тогда
            ТокенКомпиляции = Узел.Начало;
            Если Уровни.Количество() = 0 Тогда
                ВызватьИсключение ?(Вид = Типы.ИнструкцияПрепроцессораКонецЕсли, "#КонецЕсли",
                    ?(Вид = Типы.ИнструкцияПрепроцессораИначеЕсли, "#ИначеЕсли", "#Иначе"))
                    + " без #Если в том же блоке: " + ТребованиеПрепроцессора();
            КонецЕсли;
            Уровень = Уровни[Уровни.Количество() - 1];
            Если Вид = Типы.ИнструкцияПрепроцессораКонецЕсли Тогда
                Состояние.Активна = Уровень.Внешняя;
                Уровни.Удалить(Уровни.Количество() - 1);
            Иначе
                Условие = Истина;
                Если Вид = Типы.ИнструкцияПрепроцессораИначеЕсли Тогда
                    Условие = ЗначениеПрепроцессора(Узел.Выражение);
                КонецЕсли;
                Состояние.Активна = Уровень.Внешняя И Не Уровень.Выбрана И Условие;
                Уровень.Выбрана = Уровень.Выбрана Или Условие;
            КонецЕсли;
        ИначеЕсли Состояние.Активна Тогда
            Результат.Добавить(Узел);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗначениеПрепроцессора(Узел)
    Если ОпределенныеСимволы = Неопределено Тогда
        ВызватьИсключение "Условный препроцессор требует окружения компиляции (символы --define)";
    КонецЕсли;
    Вид = Узел.Тип;
    Если Вид = Типы.ВыражениеПрепроцессораСимвол Тогда
        Символ = Неопределено;
        Если Не ИменаСимволов.Свойство(Узел.Символ, Символ) Тогда
            ТокенКомпиляции = Узел.Начало;
            ВызватьИсключение "Неизвестный символ препроцессора " + Узел.Символ;
        КонецЕсли;
        Возврат ОпределенныеСимволы[Символ] = Истина;
    ИначеЕсли Вид = Типы.ВыражениеПрепроцессораНе Тогда
        Возврат Не ЗначениеПрепроцессора(Узел.Выражение);
    ИначеЕсли Вид = Типы.ВыражениеПрепроцессораСкобочное Тогда
        Возврат ЗначениеПрепроцессора(Узел.Выражение);
    ИначеЕсли Вид = Типы.ВыражениеПрепроцессораБинарное Тогда
        // Оба операнда вычисляются, чтобы неизвестный символ не прятался за коротким вычислением.
        Левый = ЗначениеПрепроцессора(Узел.ЛевыйОперанд);
        Правый = ЗначениеПрепроцессора(Узел.ПравыйОперанд);
        Возврат ?(Узел.Операция.Токен = Токены.И, Левый И Правый, Левый Или Правый);
    КонецЕсли;
    ВызватьИсключение "Не поддерживается выражение препроцессора " + Вид;
КонецФункции

Процедура U2(Буфер, Число)
    Буфер.Добавить(Цел(Число / 256) % 256);
    Буфер.Добавить(Число % 256);
КонецПроцедуры

Процедура U4(Буфер, Число)
    U2(Буфер, Цел(Число / 65536));
    U2(Буфер, Число % 65536);
КонецПроцедуры

Процедура ДобавитьБайты(Буфер, Байты)
    Для Каждого Байт Из Байты Цикл
        Буфер.Добавить(Байт);
    КонецЦикла;
КонецПроцедуры

Функция ДобавитьCP(Ключ, Байты)
    Найденный = КэшПула[Ключ];
    Если Найденный <> Неопределено Тогда
        Возврат Найденный;
    КонецЕсли;
    Если Пул.Количество() >= 65534 Тогда
        ВызватьИсключение "Переполнение constant_pool";
    КонецЕсли;
    Пул.Добавить(Байты);
    Индекс = Пул.Количество();
    КэшПула.Вставить(Ключ, Индекс);
    Возврат Индекс;
КонецФункции

Функция UTF(Текст)
    Ключ = "U:" + Текст;
    Если КэшПула[Ключ] <> Неопределено Тогда
        Возврат КэшПула[Ключ];
    КонецЕсли;
    Байты = Новый Массив;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Сим = КодСимвола(Текст, Индекс);
        Если Сим > 0 И Сим < 128 Тогда
            Байты.Добавить(Сим);
        ИначеЕсли Сим < 2048 Тогда
            Байты.Добавить(192 + Цел(Сим / 64));
            Байты.Добавить(128 + Сим % 64);
        Иначе
            Байты.Добавить(224 + Цел(Сим / 4096));
            Байты.Добавить(128 + Цел(Сим / 64) % 64);
            Байты.Добавить(128 + Сим % 64);
        КонецЕсли;
    КонецЦикла;
    Если Байты.Количество() > 65535 Тогда
        ВызватьИсключение "Слишком длинная строковая константа JVM";
    КонецЕсли;
    Запись = Новый Массив;
    Запись.Добавить(1);
    U2(Запись, Байты.Количество());
    ДобавитьБайты(Запись, Байты);
    Возврат ДобавитьCP(Ключ, Запись);
КонецФункции

Функция CPОдин(Тег, Ключ, Индекс)
    Байты = Новый Массив;
    Байты.Добавить(Тег);
    U2(Байты, Индекс);
    Возврат ДобавитьCP(Ключ, Байты);
КонецФункции

Функция CPДва(Тег, Ключ, Первый, Второй)
    Байты = Новый Массив;
    Байты.Добавить(Тег);
    U2(Байты, Первый);
    U2(Байты, Второй);
    Возврат ДобавитьCP(Ключ, Байты);
КонецФункции

Функция CPКласс(Имя)
    Возврат CPОдин(7, "C:" + Имя, UTF(Имя));
КонецФункции

Функция CPИмя(Имя, Дескриптор)
    Возврат CPДва(12, "N:" + Имя + ":" + Дескриптор, UTF(Имя), UTF(Дескриптор));
КонецФункции

Функция CPМетод(Владелец, Имя, Дескриптор)
    Возврат CPДва(10, "M:" + Владелец + ":" + Имя + ":" + Дескриптор, CPКласс(Владелец), CPИмя(Имя, Дескриптор));
КонецФункции

Функция CPПоле(Владелец, Имя, Дескриптор)
    Возврат CPДва(9, "F:" + Владелец + ":" + Имя + ":" + Дескриптор, CPКласс(Владелец), CPИмя(Имя, Дескриптор));
КонецФункции

// Глубина стека считается при выдаче команды; max_stack метода — её максимум.
// После безусловной передачи управления глубина неизвестна до следующей метки.
Процедура Команда(КодКоманды)
    Эффект = ЭффектыКоманд[КодКоманды];
    Если Эффект = Неопределено Тогда
        ВызватьИсключение "Неизвестное изменение стека для команды JVM " + Строка(КодКоманды);
    КонецЕсли;
    КомандаСЭффектом(КодКоманды, Эффект);
КонецПроцедуры

Процедура КомандаСЭффектом(КодКоманды, Эффект)
    Если Глубина = Неопределено Тогда
        Глубина = 0; // недостижимый код начинается на границе оператора
    КонецЕсли;
    Глубина = Глубина + Эффект;
    Если Глубина < 0 Тогда
        ВызватьИсключение "Отрицательная глубина стека JVM";
    КонецЕсли;
    Если Глубина > МаксГлубина Тогда
        МаксГлубина = Глубина;
    КонецЕсли;
    Код.Добавить(КодКоманды);
    Если КодКоманды = 167 Или КодКоманды = 200 Или КодКоманды = 170 Или КодКоманды = 176 Или КодКоманды = 177 Или КодКоманды = 191 Тогда
        Глубина = Неопределено;
    КонецЕсли;
КонецПроцедуры

// Операнд или выравнивание, не команда.
Процедура Байт(Значение)
    Код.Добавить(Значение);
КонецПроцедуры

Процедура СИндексом(КодКоманды, Индекс)
    Команда(КодКоманды);
    U2(Код, Индекс);
КонецПроцедуры

Процедура Вызвать(КодКоманды, Владелец, Имя, Дескриптор)
    Индекс = CPМетод(Владелец, Имя, Дескриптор);
    КомандаСЭффектом(КодКоманды, ЭффектДескриптора(Дескриптор) - ?(КодКоманды = 184, 0, 1));
    U2(Код, Индекс);
КонецПроцедуры

// Результат минус аргументы; все типы дескрипторов генератора занимают один слот.
Функция ЭффектДескриптора(Дескриптор)
    Эффект = ЭффектыДескрипторов[Дескриптор];
    Если Эффект <> Неопределено Тогда
        Возврат Эффект;
    КонецЕсли;
    Эффект = ?(Прав(Дескриптор, 2) = ")V", 0, 1);
    Индекс = 2;
    Пока Сред(Дескриптор, Индекс, 1) <> ")" Цикл
        Пока Сред(Дескриптор, Индекс, 1) = "[" Цикл
            Индекс = Индекс + 1;
        КонецЦикла;
        Если Сред(Дескриптор, Индекс, 1) = "L" Тогда
            Индекс = СтрНайти(Дескриптор, ";", , Индекс);
        КонецЕсли;
        Индекс = Индекс + 1;
        Эффект = Эффект - 1;
    КонецЦикла;
    ЭффектыДескрипторов.Вставить(Дескриптор, Эффект);
    Возврат Эффект;
КонецФункции

Процедура ЗагрузитьСтроку(Текст)
    Если СтрДлина(Текст) > 21845 Тогда
        Если ДлинаUTF(Текст) > 65535 Тогда
            // Длиннее предела CONSTANT_Utf8: строка собирается один раз в <clinit>.
            ЗагрузитьКонстанту("__juno_str_", "", Текст, "Ljava/lang/String;");
            Возврат;
        КонецЕсли;
    КонецЕсли;
    Индекс = CPОдин(8, "S:" + Текст, UTF(Текст));
    Если Индекс < 256 Тогда
        Команда(18); // ldc
        Байт(Индекс);
    Иначе
        СИндексом(19, Индекс); // ldc_w
    КонецЕсли;
КонецПроцедуры

Функция ДлинаUTF(Текст)
    Результат = 0;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Сим = КодСимвола(Текст, Индекс);
        Если Сим > 0 И Сим < 128 Тогда
            Результат = Результат + 1;
        ИначеЕсли Сим < 2048 Тогда
            Результат = Результат + 2;
        Иначе
            Результат = Результат + 3;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// 21845 единиц UTF-16 занимают не больше 65535 байт modified UTF-8; суррогатная
// пара может разделиться между частями, String.concat восстанавливает её.
Процедура ЗагрузитьЧастиСтроки(Текст)
    Если Текст = "" Тогда
        ЗагрузитьСтроку("");
        Возврат;
    КонецЕсли;
    Начало = 1;
    Пока Начало <= СтрДлина(Текст) Цикл
        ЗагрузитьСтроку(Сред(Текст, Начало, 21845));
        Если Начало > 1 Тогда
            Вызвать(182, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;");
        КонецЕсли;
        Начало = Начало + 21845;
    КонецЦикла;
КонецПроцедуры

// Неизменяемое значение создаётся один раз в <clinit> фабрикой runtime из текста.
// Пустой Метод — длинная строка, собираемая из частей.
Процедура ЗагрузитьКонстанту(Префикс, Метод, Текст, Дескриптор = "Ljava/lang/Object;")
    Ключ = Метод + ":" + Текст;
    Константа = Константы[Ключ];
    Если Константа = Неопределено Тогда
        Константа = Новый Структура("Имя,Метод,Текст,Дескриптор", Префикс + Строка(Константы.Количество()), Метод, Текст, Дескриптор);
        Константы.Вставить(Ключ, Константа);
    КонецЕсли;
    СИндексом(178, CPПоле(Класс, Константа.Имя, Константа.Дескриптор));
КонецПроцедуры

Процедура ЗагрузитьЧисло(Текст)
    ЗагрузитьКонстанту("__juno_num_", "number", Текст);
КонецПроцедуры

Процедура СгенерироватьКонстанты()
    Если Константы.Количество() = 0 И ТочкиВызовов.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    НачатьМетод();
    Для Каждого Пара Из Константы Цикл
        Константа = Пара.Значение;
        // Сборка текста напрямую не создаёт новых констант во время обхода <clinit>.
        ЗагрузитьЧастиСтроки(Константа.Текст);
        Если Константа.Метод <> "" Тогда
            Runtime(Константа.Метод, "(Ljava/lang/String;)Ljava/lang/Object;");
        КонецЕсли;
        СИндексом(179, CPПоле(Класс, Константа.Имя, Константа.Дескриптор));
    КонецЦикла;
    Порция = ПорцияТочекВызова();
    Порций = 0;
    Если ТочкиВызовов.Количество() > 0 Тогда
        // Одна строка имён и массив вместо new/dup/ldc/invokespecial на каждое место вызова.
        ЗагрузитьЧастиСтроки(СтрСоединить(ТочкиВызовов, Символ(10)));
        Runtime("sites", "(Ljava/lang/String;)[Ljuno/runtime/RuntimeSupport$MethodSite;");
        Если ТочкиВызовов.Количество() <= Порция Тогда
            Локальный(58, 0);
            ЗаполнитьТочкиВызова(0, ТочкиВызовов.Количество() - 1);
        Иначе
            // Модуль с тысячами мест вызова: поля не final, их заполняют служебные методы.
            Порций = Цел((ТочкиВызовов.Количество() + Порция - 1) / Порция);
            Для Номер = 0 По Порций - 1 Цикл
                Команда(89);
                Вызвать(184, Класс, "__juno_sites_" + Строка(Номер), "([Ljuno/runtime/RuntimeSupport$MethodSite;)V");
            КонецЦикла;
            Команда(87);
        КонецЕсли;
    КонецЕсли;
    Команда(177);
    ЗавершитьМетод("<clinit>", "()V", 8);
    Для Номер = 0 По Порций - 1 Цикл
        НачатьМетод(); // слот 0 — массив мест вызова
        ЗаполнитьТочкиВызова(Номер * Порция, Мин(ТочкиВызовов.Количество(), (Номер + 1) * Порция) - 1);
        Команда(177);
        ЗавершитьМетод("__juno_sites_" + Строка(Номер), "([Ljuno/runtime/RuntimeSupport$MethodSite;)V", 4106);
    КонецЦикла;
КонецПроцедуры

// Около 9 байт на место: порция гарантированно помещается в метод JVM.
Функция ПорцияТочекВызова()
    Возврат 4000;
КонецФункции

Процедура ЗаполнитьТочкиВызова(Первый, Последний)
    Для Индекс = Первый По Последний Цикл
        Локальный(25, 0);
        ЦелоеJVM(Индекс);
        Команда(50); // aaload
        СИндексом(179, CPПоле(Класс, "__juno_call_" + Строка(Индекс), "Ljuno/runtime/RuntimeSupport$MethodSite;"));
    КонецЦикла;
КонецПроцедуры

Процедура ЦелоеJVM(Число)
    Если Число >= 0 И Число <= 5 Тогда
        Команда(3 + Число);
    ИначеЕсли Число <= 127 Тогда
        Команда(16); // bipush
        Байт(Число);
    ИначеЕсли Число <= 32767 Тогда
        Команда(17);
        U2(Код, Число);
    Иначе
        ВызватьИсключение "Слишком большое служебное целое JVM";
    КонецЕсли;
КонецПроцедуры

Процедура Локальный(КодКоманды, Индекс)
    Если Индекс <= 3 Тогда
        // iload_n / aload_n / astore_n: однобайтовые формы для слотов 0–3.
        Команда(?(КодКоманды = 21, 26, ?(КодКоманды = 25, 42, ?(КодКоманды = 54, 59, 75))) + Индекс);
    ИначеЕсли Индекс > 255 Тогда
        Команда(196); // wide
        Команда(КодКоманды);
        U2(Код, Индекс);
    Иначе
        Команда(КодКоманды);
        Байт(Индекс);
    КонецЕсли;
КонецПроцедуры

Процедура Runtime(Имя, Дескриптор)
    Вызвать(184, "juno/runtime/RuntimeSupport", Имя, Дескриптор);
КонецПроцедуры

Процедура Неопределенное()
    Runtime("undefined", "()Ljava/lang/Object;");
КонецПроцедуры

Функция НоваяМетка()
    Метки.Добавить(Неопределено);
    ГлубиныМеток.Добавить(Неопределено);
    Возврат Метки.Количество() - 1;
КонецФункции

// Все пути к метке обязаны приходить с одной глубиной стека.
Процедура ГлубинаМетки(Метка, Значение)
    Если ГлубиныМеток[Метка] = Неопределено Тогда
        ГлубиныМеток[Метка] = Значение;
    ИначеЕсли ГлубиныМеток[Метка] <> Значение Тогда
        ВызватьИсключение "Несогласованная глубина стека JVM на метке";
    КонецЕсли;
КонецПроцедуры

Процедура Отметить(Метка)
    Метки[Метка] = Код.Количество();
    Если Глубина = Неопределено Тогда
        Глубина = ГлубиныМеток[Метка];
        Если Глубина = Неопределено Тогда
            Глубина = 0; // метка оператора, достижимая только переходом назад
        КонецЕсли;
        Если Глубина > МаксГлубина Тогда
            МаксГлубина = Глубина;
        КонецЕсли;
    КонецЕсли;
    ГлубинаМетки(Метка, Глубина);
КонецПроцедуры

Процедура Переход(КомандаПерехода, Метка)
    Если КомандаПерехода <> 153 И КомандаПерехода <> 154 И КомандаПерехода <> 167 Тогда
        ВызватьИсключение "Неподдерживаемая команда перехода " + Строка(КомандаПерехода);
    КонецЕсли;
    Если ШирокиеПереходы Тогда
        ШирокийПереход(КомандаПерехода, Метка);
        Возврат;
    КонецЕсли;
    ГлубинаМетки(Метка, ?(Глубина = Неопределено, 0, Глубина) + ЭффектыКоманд[КомандаПерехода]);
    Переходы.Добавить(Новый Структура("Позиция,Метка,Ширина,Запись", Код.Количество(), Метка, 2, Код.Количество() + 1));
    Команда(КомандаПерехода);
    U2(Код, 0);
КонецПроцедуры

// goto_w; условный переход — обратное условие на 8 байт вперёд и goto_w.
Процедура ШирокийПереход(КомандаПерехода, Метка)
    Если КомандаПерехода <> 167 Тогда
        Команда(?(КомандаПерехода = 153, 154, 153)); // ifeq <-> ifne
        U2(Код, 8);
    КонецЕсли;
    ГлубинаПосле = ?(Глубина = Неопределено, 0, Глубина);
    ГлубинаМетки(Метка, ГлубинаПосле);
    Переходы.Добавить(Новый Структура("Позиция,Метка,Ширина,Запись", Код.Количество(), Метка, 4, Код.Количество() + 1));
    Команда(200); // goto_w
    U4(Код, 0);
    Если КомандаПерехода <> 167 Тогда
        Глубина = ГлубинаПосле; // путь обратного условия продолжается после goto_w
    КонецЕсли;
КонецПроцедуры

Процедура НачатьМетод()
    Код = Новый Массив;
    СтрокиКода = Новый Массив;
    Слоты = Новый Соответствие;
    СлотыЗначений = Новый Соответствие;
    СледующийСлот = 1;
    Переходы = Новый Массив;
    Метки = Новый Массив;
    ГлубиныМеток = Новый Массив;
    Глубина = 0;
    МаксГлубина = 0;
    Исключения = Новый Массив;
    Циклы = Новый Массив;
    ИменованныеМетки = Новый Соответствие;
    Обработчики = Новый Массив;
    КонтекстыМеток = Новый Соответствие;
    НужнаПроверкаОтмены = Ложь;
    СлотОтмены = Неопределено;
КонецПроцедуры

Функция МеткаПоИмени(Имя)
    Ключ = НРег(Имя);
    Результат = ИменованныеМетки[Ключ];
    Если Результат = Неопределено Тогда
        Результат = НоваяМетка();
        ИменованныеМетки.Вставить(Ключ, Результат);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция НовыйСлот()
    Результат = СледующийСлот;
    СледующийСлот = СледующийСлот + 1;
    Возврат Результат;
КонецФункции

// Ложь — 16-битный переход не уложился, метод нужно сгенерировать в широком режиме.
Функция ЗавершитьМетод(Имя, Дескриптор, Флаги)
    Если Код.Количество() >= 65536 Тогда
        Если ТекущееОбъявление <> Неопределено Тогда
            ТокенКомпиляции = ТекущееОбъявление.Начало;
        КонецЕсли;
        ВызватьИсключение "Метод превышает размер JVM: " + Имя;
    КонецЕсли;
    Для Каждого Патч Из Переходы Цикл
        Если Метки[Патч.Метка] = Неопределено Тогда
            ВызватьИсключение "Неопределенная метка";
        КонецЕсли;
        Смещение = Метки[Патч.Метка] - Патч.Позиция;
        Если Патч.Ширина = 2 И (Смещение < -32768 Или Смещение > 32767) Тогда
            Если ПовторПриПереполнении Тогда
                Возврат Ложь;
            КонецЕсли;
            ВызватьИсключение "Слишком длинный переход в " + Имя;
        КонецЕсли;
        Байты = Новый Массив;
        Если Патч.Ширина = 2 Тогда
            U2(Байты, ?(Смещение < 0, Смещение + 65536, Смещение));
        Иначе
            U4(Байты, ?(Смещение < 0, Смещение + 4294967296, Смещение));
        КонецЕсли;
        Для Индекс = 0 По Байты.Количество() - 1 Цикл
            Код[Патч.Запись + Индекс] = Байты[Индекс];
        КонецЦикла;
    КонецЦикла;
    Метод = Новый Массив;
    U2(Метод, Флаги);
    U2(Метод, UTF(Имя));
    U2(Метод, UTF(Дескриптор));
    U2(Метод, 1);
    U2(Метод, UTF("Code"));
    U4(Метод, 12 + Код.Количество() + Исключения.Количество() * 8 + ?(СтрокиКода.Количество() = 0, 0, 8 + СтрокиКода.Количество() * 4));
    U2(Метод, МаксГлубина);
    U2(Метод, СледующийСлот);
    U4(Метод, Код.Количество());
    ДобавитьБайты(Метод, Код);
    U2(Метод, Исключения.Количество());
    Для Каждого Обработчик Из Исключения Цикл
        U2(Метод, Метки[Обработчик.Начало]);
        U2(Метод, Метки[Обработчик.Конец]);
        U2(Метод, Метки[Обработчик.Обработчик]);
        U2(Метод, Обработчик.Класс);
    КонецЦикла;
    U2(Метод, ?(СтрокиКода.Количество() = 0, 0, 1));
    Если СтрокиКода.Количество() > 0 Тогда
        U2(Метод, UTF("LineNumberTable"));
        U4(Метод, 2 + СтрокиКода.Количество() * 4);
        U2(Метод, СтрокиКода.Количество());
        Для Каждого Позиция Из СтрокиКода Цикл
            U2(Метод, Позиция.Смещение);
            U2(Метод, Позиция.Строка);
        КонецЦикла;
    КонецЕсли;
    Методы.Добавить(Метод);
    Возврат Истина;
КонецФункции

Процедура ОтметитьИсходник(Узел)
    Если Узел = Неопределено Тогда Возврат; КонецЕсли;
    ТокенКомпиляции = Узел.Начало;
    Если ТокенКомпиляции = Неопределено Тогда Возврат; КонецЕсли;
