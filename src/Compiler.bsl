        Обработчики.Добавить(Новый Структура("Ошибка,Контекст", СлотОшибки, Узел.Начало.Позиция));
        Операторы(Узел.Исключение.Операторы);
        Обработчики.Удалить(Обработчики.Количество() - 1);
        Отметить(Выход);
        Исключения.Добавить(Новый Структура("Начало,Конец,Обработчик,Класс", Начало, Конец, Обработчик, CPКласс("java/lang/RuntimeException")));
    ИначеЕсли Вид <> Типы.ИнструкцияПрепроцессораОбласть И Вид <> Типы.ИнструкцияПрепроцессораКонецОбласти Тогда
        ВызватьИсключение "Не поддерживается оператор " + Вид;
