КонецФункции

// Conservative address analysis: unknown object methods may mutate any argument.
Процедура АнализАргументов(Список, Сигнатура = Неопределено, Ссылки = Ложь, ВыходнойПараметр = -1)
    Для Индекс = 0 По Список.Количество() - 1 Цикл
        КакСсылка = Ссылки Или Индекс = ВыходнойПараметр;
        Если Сигнатура <> Неопределено И Индекс < Сигнатура.Параметры.Количество() Тогда
            КакСсылка = Не Сигнатура.Параметры[Индекс].ПоЗначению;
        КонецЕсли;
        АнализВыражения(Список[Индекс], КакСсылка);
    КонецЦикла;
КонецПроцедуры

Процедура АнализХвоста(Список)
    Для Каждого Элемент Из Список Цикл
        Если Элемент.Тип = Типы.ВыражениеИндекс Тогда
            АнализВыражения(Элемент.Выражение);
        ИначеЕсли Элемент.Аргументы <> Неопределено Тогда
            АнализАргументов(Элемент.Аргументы, Неопределено, Истина);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура АнализВыражения(Узел, КакСсылка = Ложь)
    Если Узел = Неопределено Тогда Возврат; КонецЕсли;
    Вид = Узел.Тип;
    Если Вид = Типы.ВыражениеИдентификатор Тогда
        Если Узел.Аргументы = Неопределено Тогда
            Если КакСсылка И Узел.Хвост.Количество() = 0 Тогда
                НужныСсылки.Вставить(НРег(Узел.Голова.Имя), Истина);
            КонецЕсли;
        Иначе
            Объявление = ОбъявленияМетодов[НРег(Узел.Голова.Имя)];
            Если Объявление = Неопределено Тогда
                АнализАргументов(Узел.Аргументы, Неопределено, Ложь, ВыходнойПараметрГлобальнойФункции(Узел.Голова.Имя));
            Иначе
                АнализАргументов(Узел.Аргументы, Объявление.Сигнатура);
            КонецЕсли;
        КонецЕсли;
        АнализХвоста(Узел.Хвост);
    ИначеЕсли Вид = Типы.ВыражениеБинарное Тогда
        АнализВыражения(Узел.ЛевыйОперанд);
        АнализВыражения(Узел.ПравыйОперанд);
    ИначеЕсли Вид = Типы.ВыражениеУнарное Тогда
        АнализВыражения(Узел.Операнд);
    ИначеЕсли Вид = Типы.ВыражениеНе Тогда
        АнализВыражения(Узел.Выражение);
    ИначеЕсли Вид = Типы.ВыражениеСкобочное Тогда
        АнализВыражения(Узел.Выражение, КакСсылка);
    ИначеЕсли Вид = Типы.ВыражениеНовый Тогда
        АнализАргументов(Узел.Аргументы);
        АнализХвоста(Узел.Хвост);
    ИначеЕсли Вид = Типы.ВыражениеТернарное Тогда
        АнализВыражения(Узел.Выражение);
        АнализВыражения(Узел.Тогда);
        АнализВыражения(Узел.Иначе);
        АнализХвоста(Узел.Хвост);
    КонецЕсли;
КонецПроцедуры

Процедура АнализОператоров(Список, КонтекстОбработчика = 0)
    Для Каждого Узел Из АктивныеУзлы(Список) Цикл
        Вид = Узел.Тип;
        Если Вид = Типы.ОператорПрисваивания Тогда
            АнализВыражения(Узел.ЛевыйОперанд);
            АнализВыражения(Узел.ПравыйОперанд);
        ИначеЕсли Вид = Типы.ОператорВызоваПроцедуры Тогда
            АнализВыражения(Узел.Идентификатор);
        ИначеЕсли Вид = Типы.ОператорВозврат Или Вид = Типы.ОператорВызватьИсключение Тогда
            АнализВыражения(Узел.Выражение);
        ИначеЕсли Вид = Типы.ОператорМетка Тогда
            КонтекстыМеток.Вставить(НРег(Узел.Метка), КонтекстОбработчика);
        ИначеЕсли Вид = Типы.ОператорЕсли Тогда
            АнализВыражения(Узел.Выражение);
            АнализОператоров(Узел.Тогда, КонтекстОбработчика);
            Если Узел.ИначеЕсли <> Неопределено Тогда
                Для Каждого Ветка Из Узел.ИначеЕсли Цикл
                    АнализВыражения(Ветка.Выражение);
                    АнализОператоров(Ветка.Тогда, КонтекстОбработчика);
                КонецЦикла;
            КонецЕсли;
            Если Узел.Иначе <> Неопределено Тогда АнализОператоров(Узел.Иначе.Операторы, КонтекстОбработчика); КонецЕсли;
        ИначеЕсли Вид = Типы.ОператорПока Тогда
            НужнаПроверкаОтмены = Истина;
            АнализВыражения(Узел.Выражение);
            АнализОператоров(Узел.Операторы, КонтекстОбработчика);
        ИначеЕсли Вид = Типы.ОператорДля Тогда
            НужнаПроверкаОтмены = Истина;
            АнализВыражения(Узел.Идентификатор);
            АнализВыражения(Узел.Старт);
            АнализВыражения(Узел.Финиш);
            АнализОператоров(Узел.Операторы, КонтекстОбработчика);
        ИначеЕсли Вид = Типы.ОператорДляКаждого Тогда
            НужнаПроверкаОтмены = Истина;
            АнализВыражения(Узел.Идентификатор);
            АнализВыражения(Узел.Коллекция);
            АнализОператоров(Узел.Операторы, КонтекстОбработчика);
        ИначеЕсли Вид = Типы.ОператорПерейти Тогда
            НужнаПроверкаОтмены = Истина;
        ИначеЕсли Вид = Типы.ОператорПопытка Тогда
            АнализОператоров(Узел.Попытка, КонтекстОбработчика);
            АнализОператоров(Узел.Исключение.Операторы, Узел.Начало.Позиция);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПрямойСлот(Узел)
    Если Узел.Тип = Типы.ВыражениеИдентификатор И Узел.Аргументы = Неопределено
        И Узел.Хвост.Количество() = 0 И СлотыЗначений[НРег(Узел.Голова.Имя)] = Истина Тогда
        Возврат Слоты[НРег(Узел.Голова.Имя)];
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Процедура НачатьЗапись(Узел)
    Если ПрямойСлот(Узел) = Неопределено Тогда Выражение(Узел, Истина); КонецЕсли;
КонецПроцедуры

Процедура ЗавершитьЗапись(Узел)
    Слот = ПрямойСлот(Узел);
    Если Слот = Неопределено Тогда
        Runtime("assign", "(Ljava/lang/Object;Ljava/lang/Object;)V");
    Иначе
        Локальный(58, Слот);
    КонецЕсли;
КонецПроцедуры
