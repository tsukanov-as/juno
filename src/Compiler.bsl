            Команда(177);
        КонецЕсли;
    ИначеЕсли Вид = Типы.ОператорЕсли Тогда
        Конец = НоваяМетка();
        Следующее = НоваяМетка();
        Условие(Узел.Выражение, Следующее);
        Операторы(Узел.Тогда);
        Переход(167, Конец);
        Отметить(Следующее);
        Если Узел.ИначеЕсли <> Неопределено Тогда
            Для Каждого Ветка Из Узел.ИначеЕсли Цикл
                Следующее = НоваяМетка();
                Условие(Ветка.Выражение, Следующее);
                Операторы(Ветка.Тогда);
                Переход(167, Конец);
                Отметить(Следующее);
            КонецЦикла;
        КонецЕсли;
        Если Узел.Иначе <> Неопределено Тогда
            Операторы(Узел.Иначе.Операторы);
        КонецЕсли;
        Отметить(Конец);
    ИначеЕсли Вид = Типы.ОператорПока Или Вид = Типы.ОператорДля Или Вид = Типы.ОператорДляКаждого Тогда
        ЦиклОператор(Узел);
    ИначеЕсли Вид = Типы.ОператорПерейти Тогда
        Контекст = КонтекстыМеток[НРег(Узел.Метка)];
        Если Контекст = Неопределено Тогда
            ВызватьИсключение "Неопределенная метка " + Узел.Метка;
        КонецЕсли;
        Уровень = 0;
        Если Контекст <> 0 Тогда
            Для Индекс = 0 По Обработчики.Количество() - 1 Цикл
                Если Обработчики[Индекс].Контекст = Контекст Тогда Уровень = Индекс + 1; Прервать; КонецЕсли;
            КонецЦикла;
