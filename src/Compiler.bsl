            КонецЕсли;
        КонецЕсли;
        ПроверитьОтменуНаПереходе();
        Переход(167, МеткаПоИмени(Узел.Метка));
    ИначеЕсли Вид = Типы.ОператорМетка Тогда
        Метка = МеткаПоИмени(Узел.Метка);
        Если Метки[Метка] <> Неопределено Тогда
            ВызватьИсключение "Повторная метка " + Узел.Метка;
